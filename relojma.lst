                      00164 ; Comprueba si ha chequeado la última tecla, en cuyo caso sale. Para ello testea si
                      00165 ; el contenido del registro Tecl_TeclaOrden es igual al número de teclas del teclado.
                      00166 ;
0049                  00167 Tecl_TerminaColumnas
0049   300F           00168         movlw   Tecl_UltimaTecla
004A   0248           00169         subwf   Tecl_TeclaOrden,W               ; (W) = (Tecl_TeclaOrden)-Tecl_UltimaTecla.
004B   1803           00170         btfsc   STATUS,C                ; ¿C=0?, ¿(W) negativo?, ¿(Tecl_TeclaOrden)<15?
004C   2850           00171         goto    Tecl_NoPulsada          ; No, se ha llegado al final del chequeo.
004D   1403           00172         bsf     STATUS,C                ; Sí. Va a chequear la siguiente fila.
004E   0DC9           00173         rlf     TPORTB,F                ; Apunta a la siguiente fila.
004F   2838           00174         goto    Tecl_ChequeaFila        
0050                  00175 Tecl_NoPulsada
0050   1003           00176         bcf     STATUS,C                ; Posiciona C=0, indicando que no ha pulsado
0051   2854           00177         goto    Tecl_FinTecladoLee      ; tecla alguna y sale.
0052                  00178 Tecl_GuardaValor
0052   0848           00179         movf    Tecl_TeclaOrden,W               ; El orden de la tecla pulsada en (W) y sale.
0053   1403           00180         bsf     STATUS,C                ; Como hay tecla tecla pulsada, pone C=1. 
0054                  00181 Tecl_FinTecladoLee
0054   0008           00182         return
