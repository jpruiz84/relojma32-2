  000000F0            00111 Teclado_Comprobacion    EQU     b'11110000'
                      00112 
0027                  00113 Teclado_EsperaDejePulsar:
0027   1005           00114         BCF     PORTA,0
0028   1086           00115         BCF     PORTB,1
0029   1106           00116         BCF     PORTB,2 
002A   1186           00117         BCF     PORTB,3
002B   30F0           00118         movlw   Teclado_Comprobacion    ; Pone a cero las cuatro líneas de salida del 
002C   0086           00119         movwf   PORTB                   ; Puerto B.
002D                  00120 Teclado_SigueEsperando
002D   0064           00121         clrwdt
002E   26D4           00122         call    Retardo_20ms            ; Espera a que se estabilicen los niveles de tensión.
002F   0806           00123         movf    PORTB,W         ; Lee el Puerto B.
0030   39F0           00124         andlw   b'11110000'
0031   3CF0           00125         sublw   Teclado_Comprobacion    ; Si es lo mismo que escribió es que ya no pulsa 
0032   1D03           00126         btfss   STATUS,Z                ; tecla alguna.
0033   282D           00127         goto    Teclado_SigueEsperando
0034   0008           00128         return
                      00129 ;
                      00130 ; Subrutina "Teclado_LeeOrdenTecla" -----------------------------------------------------
                      00131 ;
                      00132 ; Lee el teclado, obteniendo el orden de la tecla pulsada. 
                      00133 ;
                      00134 ; Salida:       En (W) el número de orden de la tecla pulsada. Además Carry se pone a "1" si
                      00135 ;               se pulsa una tecla ó a "0" si no se pulsa tecla alguna. q       
                      00136 ;
0035                  00137 Teclado_LeeOrdenTecla:
0035   01C8           00138         clrf    Tecl_TeclaOrden         ; Todavía no ha empezado a chequear el teclado.
0036   30FE           00139         movlw   b'11111110'             ; Va a chequear primera fila.
0037   00C9           00140         movwf   TPORTB
0038                  00141 Tecl_ChequeaFila
0038   1005           00142         BCF     PORTA,0
0039   1849           00143         BTFSC   TPORTB,0
003A   1405           00144         BSF     PORTA,0                         ; (Ver esquema de conexión).
003B   0849           00145         MOVF    TPORTB,W
003C   0086           00146         movwf   PORTB                   ; Activa la fila correspondiente.
003D                  00147 Tecl_Columna1
003D   1E06           00148         btfss   PORTB,4                 ; Chequea la 1ª columna buscando un cero. 
003E   2852           00149         goto    Tecl_GuardaValor                ; Sí, es cero y por tanto guarda su valor y sale.
003F   0AC8           00150         incf    Tecl_TeclaOrden,F               ; Va a chequear la siguiente tecla.
0040                  00151 Tecl_Columna2                           ; Repite proceso para las siguientes 
0040   1E86           00152         btfss   PORTB,5                 ; columnas.
0041   2852           00153         goto    Tecl_GuardaValor
0042   0AC8           00154         incf    Tecl_TeclaOrden,F
0043                  00155 Tecl_Columna3           
0043   1F06           00156         btfss   PORTB,6
0044   2852           00157         goto    Tecl_GuardaValor
0045   0AC8           00158         incf    Tecl_TeclaOrden,F
0046                  00159 Tecl_Columna4           
0046   1F86           00160         btfss   PORTB,7
0047   2852           00161         goto    Tecl_GuardaValor
0048   0AC8           00162         incf    Tecl_TeclaOrden,F
                      00163 ;
