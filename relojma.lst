LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

0739   2715           00122         call    SCL_AltaImpedancia      ; Pulso en alto de reloj para que el esclavo
073A   26BD           00123         call    Retardo_4micros         ; pueda enviar el bit ACK.
073B   2710           00124         call    SCL_Bajo
073C   26BD           00125         call    Retardo_4micros
073D   0008           00126         return
                      00127 ;
                      00128 ; Subrutina "I2C_LeeByte" ---------------------------------------------------------------
                      00129 ;
                      00130 ; El microcontrolador maestro lee un byte desde el esclavo conectado al bus I2C. El dato
                      00131 ; recibido se carga en el registro I2C_Dato y lo envía a la subrutina superior a través
                      00132 ; del registro W. Se empieza a leer por el bit de mayor peso MSB.
                      00133 ; De alguna de las subrutinas ejecutadas anteriormente I2C_EnviaStart, I2C_EnviaByte
                      00134 ; o esta misma I2C_LeeByte, la línea SCL lleva en bajo al menos 5 µs.
                      00135 
073E                  00136 I2C_LeeByte
073E   3008           00137         movlw   0x08                    ; A recibir 8 bits.
073F   00D6           00138         movwf   I2C_ContadorBits
0740   270C           00139         call    SDA_AltaImpedancia      ; Deja libre la línea de datos.
0741                  00140 I2C_LeeBit
0741   2715           00141         call    SCL_AltaImpedancia      ; Flanco de subida del reloj.
0742   1003           00142         bcf     STATUS,C                ; En principio supone que es "0".
0743   1A05           00143         btfsc   SDA                     ; Lee el bit
0744   1403           00144         bsf     STATUS,C                ; Si es "1" carga 1 en el Carry.
0745   0DD7           00145         rlf     I2C_Dato,F              ; Lo introduce en el registro.
0746   2710           00146         call    SCL_Bajo                ; Termina el semiperiodo positivo del reloj.
0747   26BD           00147         call    Retardo_4micros         ; Tiempo tHD;DAT del protocolo.
0748   0BD6           00148         decfsz  I2C_ContadorBits,F              ; Lazo para los 8 bits.
0749   2F41           00149         goto    I2C_LeeBit
                      00150 ;
                      00151 ; Chequea si este es el último byte a leer para enviar o no el bit de reconocimiento
                      00152 ; ACK en consecuencia.
                      00153 ;
074A   1C58           00154         btfss   I2C_UltimoByteLeer      ; Si es el último, no debe enviar
                      00155                                         ; el bit de reconocimiento ACK.
074B   2707           00156         call    SDA_Bajo                ; Envía el bit de reconocimiento ACK
                      00157                                         ; porque todavía no es el último byte a leer.
074C   2715           00158         call    SCL_AltaImpedancia      ; Pulso en alto del SCL para transmitir el
074D   26BD           00159         call    Retardo_4micros         ; bit ACK de reconocimiento. Este es tHIGH.
074E   2710           00160         call    SCL_Bajo                ; Pulso de bajada del SCL.
074F   26BD           00161         call    Retardo_4micros
0750   0857           00162         movf    I2C_Dato,W              ; El resultado se manda en el registro de
0751   0008           00163         return                          ; de trabajo W.
                      00164         
