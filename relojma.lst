                      00020 #DEFINE I2C_UltimoByteLeer      I2C_Flags,0
                      00021 ;    -  (I2C_UltimoByteLeer)=0, NO es el último byte a leer por el maestro.
                      00022 ;    -  (I2C_UltimoByteLeer)=1, SÍ es el último byte a leer por el maestro.
                      00023 
                      00024 ; La definición de las líneas SCL y SDA del bus I2C se puede cambiar según las
                      00025 ; necesidades del hardware.
                      00026 
                      00027 #DEFINE SCL     PORTA,3                 ; Línea SCL del bus I2C.
                      00028 #DEFINE SDA     PORTA,4                 ; Línea SDA del bus I2C.
                      00029 ;
                      00030 ; Subrutina "SDA_Bajo" -------------------------------------------------------------------------------
                      00031 ;
0707                  00032 SDA_Bajo
0707   1683           00033         bsf     STATUS,RP0              ; Configura la línea SDA como salida.
0708   1205           00034         bcf     SDA
0709   1283           00035         bcf     STATUS,RP0
070A   1205           00036         bcf     SDA                     ; SDA en bajo.
070B   0008           00037         return
                      00038 ;
                      00039 ; Subrutina "SDA_AltaImpedancia" --------------------------------------------------------
                      00040 ;
070C                  00041 SDA_AltaImpedancia
070C   1683           00042         bsf     STATUS,RP0              ; Configura la línea SDA entrada.
070D   1605           00043         bsf     SDA                     ; Lo pone en alta impedancia y, gracias a la
070E   1283           00044         bcf     STATUS,RP0              ; Rp de esta línea, se mantiene a nivel alto.
070F   0008           00045         return
                      00046 ;
                      00047 ; Subrutina "SCL_Bajo" ------------------------------------------------------------------
                      00048 ;
0710                  00049 SCL_Bajo
0710   1683           00050         bsf     STATUS,RP0
0711   1185           00051         bcf     SCL                     ; Configura la línea SCL como salida.
0712   1283           00052         bcf     STATUS,RP0
0713   1185           00053         bcf     SCL                     ; La línea de reloj SCL en bajo.
0714   0008           00054         return
                      00055 ;
                      00056 ; Subrutina "SCL_AltaImpedancia" --------------------------------------------------------
                      00057 ;
0715                  00058 SCL_AltaImpedancia
0715   1683           00059         bsf     STATUS,RP0              ; Configura la línea SCL entrada.
0716   1585           00060         bsf     SCL                     ; Lo pone en alta impedancia y, gracias a la Rp
0717   1283           00061         bcf     STATUS,RP0              ; de esta línea, se mantiene a nivel alto.
0718                  00062 SCL_EsperaNivelAlto
0718   1D85           00063         btfss   SCL                     ; Si algún esclavo mantiene esta línea en bajo
0719   2F18           00064         goto    SCL_EsperaNivelAlto     ; hay que esperar.
071A   0008           00065         return
                      00066 ;
