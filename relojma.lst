06BD                  00041 Retardo_4micros                         ; La llamada "call" aporta 2 ciclos máquina.
06BD   0008           00042         return                          ; El salto del retorno aporta 2 ciclos máquina.
                      00043 ;
                      00044 ; RETARDOS de 20 hasta 500 microsegundos ------------------------------------------------
                      00045 ;
06BE                  00046 Retardo_500micros                               ; La llamada "call" aporta 2 ciclos máquina.
