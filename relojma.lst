                      00037 ;FUNCION DE BINARIO A DECIMAL 99 *******************************************************************
                      00038 ; Esta función convierte un valor de binario a decimal igual o menor a 99. El dato de entrada se 
                      00039 ; lo coloca en W y la función devuelve su respuesta en W donde el nibble mayor representa las
                      00040 ; centenas y el nibble menor las unidades. Si el dato de entrada es mayor a 99 devuelve el Carry
MPASM  5.42                       RELOJMA.ASM   9-28-2014  11:00:19         PAGE 62


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00041 ; en 1 y si el dato es menor o igual a 99 devuelve el Carry 0.
0900                  00042 BINAD99
0900   00E1           00043         MOVWF   D99UNI                  ; Coloca el dato de entrada en D99UNI
0901   01E2           00044         CLRF    D99DEC                  ; Coloca en cero a D99DEC
0902                  00045 BINAD991
0902   300A           00046         MOVLW   d'10'                   ; Resta 10 a D99UNI y lo almacena en W
0903   0261           00047         SUBWF   D99UNI,W
0904   1C03           00048         BTFSS   STATUS,C
0905   290F           00049         GOTO    BINAD99F                ; Si el resultado es negativo, D99UNI<10 termina
0906                  00050 BINAD992                                ; Si el resultado es cero o positivo, D99UNI>=10
0906   00E1           00051         MOVWF   D99UNI                  ; Aplica el resultado de la resta sobre D99UNI
0907   0AE2           00052         INCF    D99DEC,F                ; Incrementa en uno las decenas
0908   300A           00053         MOVLW   d'10'                   ; Resta 10 a D99UNI para saber si las decenas
0909   0262           00054         SUBWF   D99DEC,W                ; son mayores que 10
090A   1C03           00055         BTFSS   STATUS,C                
090B   2902           00056         GOTO    BINAD991                ; Si el resultado es negativo, D99DEC<10 continua
090C                  00057 BINAD99E                                ; si es positivo, D99DEC>10 va a error
090C   00E2           00058         MOVWF   D99DEC  
090D   1403           00059         BSF     STATUS,C                ; Coloca el Carry en 1 para avizar que hay un error
090E   0008           00060         RETURN                          ; Finaliza
090F                  00061 BINAD99F
090F   0EE2           00062         SWAPF   D99DEC,F                ; Rota los nibbles de D99DEC
0910   0862           00063         MOVF    D99DEC,W                
0911   0761           00064         ADDWF   D99UNI,W                ; Los suma con D99UNI en W.
0912   1003           00065         BCF     STATUS,C                ; Coloca el Carry en 0, operación exitosa
0913   0008           00066         RETURN                          ; Termina la función
