                      00214 ; Subrutina "LCD_CodigoCGROM" -----------------------------------------------------------
                      00215 ;
                      00216 ; A partir del carácter ASCII número 127 los códigos de los caracteres definidos en la
                      00217 ; tabla CGROM del LM016L no coinciden con los códigos ASCII. Así por ejemplo, el código
                      00218 ; ASCII de la "Ñ" en la tabla CGRAM del LM016L es EEh.
                      00219 ;
                      00220 ; Esta subrutina convierte los códigos ASCII de la "Ñ", "º" y otros, a códigos CGROM para que
MPASM  5.42                       RELOJMA.ASM   9-28-2014  11:00:19         PAGE 45


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00221 ; que puedan ser visualizado en el módulo LM016L.
                      00222 ; 
                      00223 ; Entrada:      En (W) el código ASCII del carácter que se desea visualizar.
                      00224 ; Salida:       En (W) el código definido en la tabla CGROM.
                      00225 
0614                  00226 LCD_CodigoCGROM
0614   00CC           00227         movwf   LCD_Dato                ; Guarda el valor del carácter y comprueba si es
0615                  00228 LCD_EnheMinuscula                       ; un carácter especial.
0615   3CF1           00229         sublw   'ñ'                     ; ¿Es la "ñ"?
0616   1D03           00230         btfss   STATUS,Z
0617   2E1B           00231         goto    LCD_EnheMayuscula       ; No es "ñ".
0618   30EE           00232         movlw   b'11101110'             ; Código CGROM de la "ñ".
0619   00CC           00233         movwf   LCD_Dato
061A   2E28           00234         goto    LCD_FinCGROM
061B                  00235 LCD_EnheMayuscula
061B   084C           00236         movf    LCD_Dato,W              ; Recupera el código ASCII de entrada.
061C   3CD1           00237         sublw   'Ñ'                     ; ¿Es la "Ñ"?
061D   1D03           00238         btfss   STATUS,Z
061E   2E22           00239         goto    LCD_Grado               ; No es "Ñ".
061F   30EE           00240         movlw   b'11101110'             ; Código CGROM de la "ñ". (No hay símbolo para
0620   00CC           00241         movwf   LCD_Dato                ; la "Ñ" mayúscula en la CGROM).
0621   2E28           00242         goto    LCD_FinCGROM    
0622                  00243 LCD_Grado
0622   084C           00244         movf    LCD_Dato,W              ; Recupera el código ASCII de entrada.
0623   3CBA           00245         sublw   'º'                     ; ¿Es el símbolo "º"?
0624   1D03           00246         btfss   STATUS,Z
0625   2E28           00247         goto    LCD_FinCGROM            ; No es "º".
0626   30DF           00248         movlw   b'11011111'             ; Código CGROM del símbolo "º".
0627   00CC           00249         movwf   LCD_Dato
0628                  00250 LCD_FinCGROM
0628   084C           00251         movf    LCD_Dato,W              ; En (W) el código buscado.
0629   0008           00252         return
