                      00090 ; y comprueba que no hay pulsada tecla alguna al principio.
                      00091 
001C                  00092 Teclado_Inicializa
001C   1683           00093         bsf     STATUS,RP0              ; Configura las líneas del puerto:
001D   1005           00094         BCF     PORTA,0
001E   1086           00095         BCF     PORTB,1
001F   1106           00096         BCF     PORTB,2
0020   1186           00097         BCF     PORTB,3
0021   1606           00098         BSF     PORTB,4
0022   1686           00099         BSF     PORTB,5
0023   1706           00100         BSF     PORTB,6
0024   1786           00101         BSF     PORTB,7
