                      00010 ; conectado al Puerto B según la disposición siguiente y explicada en la figura 19-2 del libro:
                      00011 ;
                      00012 ;                RB4 RB5 RB6 RB7
                      00013 ;                  ^    ^    ^    ^
                      00014 ;               |----|----|----|----|
                      00015 ;       RA0 --> |  0 |  1 |  2 |  3 |
                      00016 ;               |----|----|----|----|
                      00017 ;       RB1 --> |  4 |  5 |  6 |  7 |
                      00018 ;               |----|----|----|----|
                      00019 ;       RB2 --> |  8 |  9 | 10 | 11 |
                      00020 ;               |----|----|----|----|
                      00021 ;       RB3 --> | 12 | 13 | 14 | 15 |
                      00022 ;               |----|----|----|----|
                      00023 ;
                      00024 ; Los números que se han dibujado dentro de cada cuadrado son el orden de las teclas
                      00025 ; que no tienen por qué coincidir con lo serigrafiado sobre ellas. El paso del número de orden
                      00026 ; de la tecla al valor que hay serigrafiado sobre la misma se hace con una tabla de conversión.
                      00027 ;
                      00028 ; ZONA DE DATOS **********************************************************************
                      00029 ;
                      00030         CBLOCK
  00000048            00031         Tecl_TeclaOrden                 ; Orden de la tecla a chequear.
  00000049            00032         TPORTB
  0000004A            00033         TEMPTECLADO
  0000004B            00034         MAXTECLADO
                      00035         ENDC
                      00036 
  0000000F            00037 Tecl_UltimaTecla        EQU     d'15'           ; Valor de orden de la última tecla utilizada.
                      00038 
                      00039 ; Subrutina "Teclado_LeeHex" ************************************************************
                      00040 ;
                      00041 ; Cada tecla tiene asignado un número de orden que es contabilizado en la variable
                      00042 ; Tecl_TeclaOrden. Para convertir a su valor según el tipo de teclado en concreto se
                      00043 ; utiliza una tabla de conversión. 
                      00044 ; A continuación se expone la relación entre el número de orden de la tecla y los
                      00045 ; valores correspondientes para el teclado hexadecimal más utilizado.
                      00046 ;
                      00047 ;           ORDEN DE TECLA:             TECLADO HEX. UTILIZADO:
                      00048 ;                0   1   2   3                  1  2  3  F
                      00049 ;                4   5   6   7                  4  5  6  E
                      00050 ;                8   9  10  11                  7  8  9  D
                      00051 ;               12  13  14  15                  A  0  B  C
                      00052 ;
                      00053 ; Así, en este ejemplo, la tecla "7" ocupa el orden 8, la tecla "F" ocupa el orden 3 y la
                      00054 ; tecla "9" el orden 10.
                      00055 
                      00056 ; Si cambia el teclado también hay cambiar de tabla de conversión.
                      00057 ;
                      00058 ; Entrada:      En (W) el orden de la tecla pulsada.
                      00059 ; Salida:       En (W) el valor hexadecimal para este teclado concreto.
                      00060 ;
0005                  00061 Teclado_LeeHex
0005   2035           00062         call    Teclado_LeeOrdenTecla   ; Lee el Orden de la tecla pulsada.
MPASM  5.42                       RELOJMA.ASM   9-28-2014  11:00:19         PAGE  4


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

0006   1C03           00063         btfss   STATUS,C                ; ¿Pulsa alguna tecla?, ¿C=1?
0007   280A           00064         goto    Tecl_FinLeeHex          ; No, por tanto sale.
0008   200B           00065         call    Tecl_ConvierteOrdenEnHex        ; Lo convierte en su valor real mediante tabla.
0009   1403           00066         bsf     STATUS,C                ; Vuelve a posicionar el Carry, porque la
000A                  00067 Tecl_FinLeeHex                          ; instrucción "addwf PCL,F" lo pone a "0".
000A   0008           00068         return
                      00069 ;
000B                  00070 Tecl_ConvierteOrdenEnHex                        ; Según el teclado utilizado resulta:
000B   0782           00071         addwf   PCL,F
000C   3401 3402 3403 00072         DT      1h,2h,3h,0Fh            ; Primera fila del teclado.
       340F 
0010   3404 3405 3406 00073         DT      4h,5h,6h,0Eh            ; Segunda fila del teclado
       340E 
0014   3407 3408 3409 00074         DT      7h,8h,9h,0Dh            ; Tercera fila del teclado.
       340D 
0018   340A 3400 340B 00075         DT      0Ah,0h,0Bh,0Ch          ; Cuarta fila del teclado.
       340C 
001C                  00076 Teclado_FinTablaHex
                      00077 ;
                      00078 ; Esta tabla se sitúa al principio de la librería con el propósito de que no supere la
                      00079 ; posición 0FFh de memoria ROM de programa. De todas formas, en caso que así fuera 
                      00080 ; visualizaría el siguiente mensaje de error en el proceso de ensamblado:
                      00081 ;
                      00082         IF (Teclado_FinTablaHex > 0xFF)
                      00083                 ERROR   "Atención: La tabla ha superado el tamaño de la página de los"
                      00084                 MESSG   "primeros 256 bytes de memoria ROM. NO funcionará correctamente."
                      00085         ENDIF
