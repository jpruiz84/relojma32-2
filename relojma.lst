0730   2F32           00110         goto    I2C_FlancoSCL
0731                  00111 I2C_EnviaUno
0731   270C           00112         call    SDA_AltaImpedancia      ; Si es "1" lo activará a alto.
0732                  00113 I2C_FlancoSCL
0732   2715           00114         call    SCL_AltaImpedancia      ; Flanco de subida del SCL.
0733   26BD           00115         call    Retardo_4micros         ; Tiempo tHIGH del protocolo.
0734   2710           00116         call    SCL_Bajo                ; Termina el semiperiodo positivo del reloj.
0735   26BD           00117         call    Retardo_4micros         ; Tiempo tHD;DAT del protocolo.
0736   0BD6           00118         decfsz  I2C_ContadorBits,F              ; Lazo para los ocho bits.
