06C0   2ECA           00049         goto    RetardoMicros           ; Aporta 2 ciclos máquina.
06C1                  00050 Retardo_200micros                               ; La llamada "call" aporta 2 ciclos máquina.
06C1   0000           00051         nop                             ; Aporta 1 ciclo máquina.
06C2   3040           00052         movlw   d'64'                   ; Aporta 1 ciclo máquina. Este es el valor de "K".
06C3   2ECA           00053         goto    RetardoMicros           ; Aporta 2 ciclos máquina.
06C4                  00054 Retardo_100micros                               ; La llamada "call" aporta 2 ciclos máquina.
06C4   301F           00055         movlw   d'31'                   ; Aporta 1 ciclo máquina. Este es el valor de "K".
06C5   2ECA           00056         goto    RetardoMicros           ; Aporta 2 ciclos máquina.
06C6                  00057 Retardo_50micros                                ; La llamada "call" aporta 2 ciclos máquina.
