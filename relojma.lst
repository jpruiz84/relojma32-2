077E   00D9           00090         movwf   Anho                    ; Inicializa en el año 2011.
077F   01DD           00091         clrf    Hora
0780   01DE           00092         clrf    Minuto
0781   01DF           00093         clrf    Segundo                 ; Después lo graba en el DS1307 para
                      00094 ;       call    DS1307_Escribe          ; ponerlo en marcha.
                      00095 ;       return
                      00096 ;
                      00097 ; Subrutina "DS1307_Escribe" ----------------------------------------------------------------
                      00098 ;
