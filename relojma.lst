                      00123 ; Subrutina "LCD_EscribeLCD" -----------------------------------------------------------
                      00124 ;
                      00125 ; Envía el dato del registro de trabajo W al bus de dato y produce un pequeño pulso en el pin
                      00126 ; Enable del LCD. Para no alterar el contenido de las líneas de la parte baja del Puerto B que
                      00127 ; no son utilizadas para el LCD (pines RB3:RB0), primero se lee estas líneas y después se
                      00128 ; vuelve a enviar este dato sin cambiarlo.
                      00129 
05E1                  00130 LCD_EscribeLCD
05E1   39F0           00131         andlw   b'11110000'             ; Se queda con el nibble alto del dato que es el
05E2   00CC           00132         movwf   LCD_Dato                ; que hay que enviar y lo guarda.
05E3   0808           00133         movf    LCD_BusDatos,W          ; Lee la información actual de la parte baja
05E4   390F           00134         andlw   b'00001111'             ; del Puerto B, que no se debe alterar.
05E5   074C           00135         addwf   LCD_Dato,W              ; Enviará la parte alta del dato de entrada
                      00136                                         ; y en la parte baja lo que había antes.
                      00137 
05E6   0088           00138         movwf   LCD_BusDatos            ; Envía el dato al módulo LCD.
05E7   1588           00139         bsf     LCD_PinEnable           ; Permite funcionamiento del LCD mediante un pequeño
05E8   26B7           00140         CALL    Retardo_10micros
05E9   1188           00141         bcf     LCD_PinEnable           ; pulso y termina impidiendo el funcionamiento del LCD.
05EA   0008           00142         return
                      00143 
