  0000005B            00017         Dia                             ; Guarda el día.
  0000005C            00018         DiaSemana                       ; Guarda el día de la semana: lunes, etc.
  0000005D            00019         Hora                            ; Guarda las horas.
  0000005E            00020         Minuto                          ; Guarda los minutos.
  0000005F            00021         Segundo                         ; Guarda los segundos.
