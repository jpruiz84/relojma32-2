  000000D0            00024 DS1307_DireccionEscritura       EQU     0xD0    ; Dirección del DS1307.
  000000D1            00025 DS1307_DireccionLectura EQU     0xD1
                      00026  
                      00027 ; Subrutina "DS1307_Inicializa" ---------------------------------------------------------
                      00028 ;
                      00029 ; Configura la señal cuadrada que genera el DS1307 en su pin SQW/OUT a 1 Hz.
                      00030 
0752                  00031 DS1307_Inicializa
0752   271B           00032         call    I2C_EnviaStart          ; Envía condición de Start.
0753   30D0           00033         movlw   DS1307_DireccionEscritura       ; Indica al DS1307 que el byte a escribir,
0754   2729           00034         call    I2C_EnviaByte           ; está en la posición 07h, que corresponde
0755   3007           00035         movlw   0x07                    ; al control de la señal cuadrada.
0756   2729           00036         call    I2C_EnviaByte
0757   3010           00037         movlw   b'00010000'             ; Escribe en el registro de control para
0758   2729           00038         call    I2C_EnviaByte           ; configurar onda cuadrada del DS1307 a 1 Hz.
0759   2723           00039         call    I2C_EnviaStop           ; Termina de enviar datos.
075A   0008           00040         return
                      00041 
                      00042 ; Subrutina "DS1307_Lee" ----------------------------------------------------------------
                      00043 ;
                      00044 ; Se leen las variables de tiempo del DS1307 y se guardan en los registros correspondientes.
                      00045 ;
075B                  00046 DS1307_Lee
075B   1058           00047         bcf     I2C_UltimoByteLeer
075C   271B           00048         call    I2C_EnviaStart          ; Envía condición de Start.
075D   30D0           00049         movlw   DS1307_DireccionEscritura       ; Indica al DS1307 que el primer byte
075E   2729           00050         call    I2C_EnviaByte           ; a leer está en la posición 00H, que corresponde
075F   3000           00051         movlw   0x00                    ; a los segundos.
0760   2729           00052         call    I2C_EnviaByte
0761   2723           00053         call    I2C_EnviaStop           ; Envía condición de Stop.
                      00054                                         ; Ahora va a leer el DS1307.
0762   271B           00055         call    I2C_EnviaStart          ; Envía condición de Start.
0763   30D1           00056         movlw   DS1307_DireccionLectura
0764   2729           00057         call    I2C_EnviaByte
