  VALUE

                      00069 ; Esta subrutina envía una condición de Start o inicio.
                      00070 ;
071B                  00071 I2C_EnviaStart
071B   270C           00072         call    SDA_AltaImpedancia      ; Línea SDA en alto.
071C   2715           00073         call    SCL_AltaImpedancia      ; Línea SCL en alto.
071D   26BD           00074         call    Retardo_4micros         ; Tiempo tBUF del protocolo.
071E   2707           00075         call    SDA_Bajo                ; Flanco de bajada de SDA mientras SCL está alto.
071F   26BD           00076         call    Retardo_4micros         ; Tiempo tHD;STA del protocolo.
0720   2710           00077         call    SCL_Bajo                ; Flanco de bajada del reloj SCL.
0721   26BD           00078         call    Retardo_4micros 
0722   0008           00079         return
                      00080 ;
                      00081 ; Subrutina "I2C_EnviaStop" -------------------------------------------------------------
                      00082 ;
                      00083 ; Esta subrutina envía un condición de Stop o parada.
                      00084 ;
0723                  00085 I2C_EnviaStop
0723   2707           00086         call    SDA_Bajo
0724   2715           00087         call    SCL_AltaImpedancia      ; Flanco de subida de SCL.
0725   26BD           00088         call    Retardo_4micros         ; Tiempo tSU;STO del protocolo.
0726   270C           00089         call    SDA_AltaImpedancia      ; Flanco de subida de SDA.
0727   26BD           00090         call    Retardo_4micros         ; Tiempo tBUF del protocolo.
0728   0008           00091         return
                      00092 ;
                      00093 ; Subrutina "I2C_EnviaByte" -------------------------------------------------------------
                      00094 ;
                      00095 ; El microcontrolador maestro transmite un byte por el bus I2C, comenzando por el bit
                      00096 ; MSB. El byte a transmitir debe estar cargado previamente en el registro de trabajo W.
                      00097 ; De la subrutina ejecutada anteriormente I2C_EnviaStart o esta misma I2C_EnviaByte, 
                      00098 ; la línea SCL se debe encontrar a nivel bajo al menos durante 5 µs.
                      00099 ;
0729                  00100 I2C_EnviaByte
0729   00D7           00101         movwf   I2C_Dato                        ; Almacena el byte a transmitir.
072A   3008           00102         movlw   0x08                    ; A transmitir 8 bits.
072B   00D6           00103         movwf   I2C_ContadorBits
072C                  00104 I2C_EnviaBit
072C   0DD7           00105         rlf     I2C_Dato,F              ; Chequea el bit, llevándolo previamente al Carry.
072D   1803           00106         btfsc   STATUS,C
072E   2F31           00107         goto    I2C_EnviaUno
072F                  00108 I2C_EnviaCero
