                      00026 ;
                      00027 ; RETARDOS de 4 hasta 10 microsegundos ---------------------------------------------------
                      00028 ;
                      00029 ; A continuación retardos pequeños teniendo en cuenta que para una frecuencia de 4 MHZ,
                      00030 ; la llamada a subrutina "call" tarda 2 ciclos máquina, el retorno de subrutina
                      00031 ; "return" toma otros 2 ciclos máquina y cada instrucción "nop" tarda 1 ciclo máquina.
                      00032 ;
06B7                  00033 Retardo_10micros                                ; La llamada "call" aporta 2 ciclos máquina.
06B7   0000           00034         nop                             ; Aporta 1 ciclo máquina.
06B8   0000           00035         nop                             ; Aporta 1 ciclo máquina.
06B9   0000           00036         nop                             ; Aporta 1 ciclo máquina.
06BA   0000           00037         nop                             ; Aporta 1 ciclo máquina.
06BB   0000           00038         nop                             ; Aporta 1 ciclo máquina.
06BC                  00039 Retardo_5micros                         ; La llamada "call" aporta 2 ciclos máquina.
