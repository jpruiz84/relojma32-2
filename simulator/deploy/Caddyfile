{
	admin localhost:2019
	# IP-address clients generally omit TLS SNI.
	default_sni {$SERVER_IP}
}

https://{$SERVER_IP} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
	}

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cache-Control "private, no-store"
		-Server
	}
	encode zstd gzip

	# The prefix is a bearer secret; never enable access logging here.
	@withoutSlash path {$ACCESS_PATH}
	redir @withoutSlash {$ACCESS_PATH}/ 308
	handle_path {$ACCESS_PATH}/* {
		root * /srv/current
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
