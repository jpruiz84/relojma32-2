00000AA1,022B,,        SUBWF   VTIPOHORARIO,W
00000AA2,1D03,,        BTFSS   STATUS,Z
00000AA3,0008,,        RETURN
00000AA4,3004,,        MOVLW   0x04
00000AA5,00AB,,        MOVWF   VTIPOHORARIO
00000AA6,0008,,        RETURN
,,,
,,,
,,,; COMPROBAR ALARMAS ************************************************************************************
,,,; Comprueba cual es la alarma mas sercana
,,,
00000AA7,,INCDIASEMANA,INCDIASEMANA
00000AA7,0ADC,,        INCF    DiaSemana,F
00000AA8,3008,,        MOVLW   0x08
00000AA9,025C,,        SUBWF   DiaSemana,W
00000AAA,1903,,        BTFSC   STATUS,Z
00000AAB,2AAF,,        GOTO    INCDIASEMANA1
00000AAC,01DD,,        CLRF    Hora                    ; Resetea hora y minuto para que detecte la primera
00000AAD,01DE,,        CLRF    Minuto                  ; alarma del siguiente día
00000AAE,0008,,        RETURN
00000AAF,,INCDIASEMANA1,INCDIASEMANA1
00000AAF,01DC,,        CLRF    DiaSemana
00000AB0,0ADC,,        INCF    DiaSemana,F
00000AB1,01DD,,        CLRF    Hora                    ; Resetea hora y minuto para que detecte la primera
00000AB2,01DE,,        CLRF    Minuto                  ; alarma del siguiente día
00000AB3,0008,,        RETURN
,,,
,,,; Inicio subrutina comparar alarmas
,,,
00000AB4,,COMPALARMAS,COMPALARMAS
00000AB4,01A5,,        CLRF    NALARMA
00000AB5,0AA5,,        INCF    NALARMA,F
00000AB6,3007,,        MOVLW   0x07                    ; Coloca el día domingo en CONTDIATH
00000AB7,00C4,,        MOVWF   CONTDIATH
00000AB8,01C6,,        CLRF    TOTALADIAS              ; Resetea TOTALDIAS
,,,
00000AB9,,COMPALARMASDZ,COMPALARMASDZ
00000AB9,30F1,,        MOVLW   EEDDTHLUN               ; Coloca la posición en la eeprom del día
00000ABA,0744,,        ADDWF   CONTDIATH,W             ; Empieza a comprobar desde el Domingo hacia abajo
00000ABB,018A,,        CLRF    PCLATH                  ; si el día esta o no activado
00000ABC,2799,,        CALL    EEDIR
00000ABD,018A,,        CLRF    PCLATH                  ; Pagina 0
00000ABE,279F,,        CALL    EELEER
00000ABF,158A,,        BSF     PCLATH,3                ; Pagina 1
00000AC0,120A,,        BCF     PCLATH,4
00000AC1,07C6,,        ADDWF   TOTALADIAS,F            ; Va almacenando en TOTALDIAS
00000AC2,0BC4,,        DECFSZ  CONTDIATH,F
00000AC3,2AB9,,        GOTO    COMPALARMASDZ
,,,
00000AC4,01B1,,        CLRF    NALARMACERCANA          ; Si TOTALDIAS es cero es porque ningun día esta activado
00000AC5,08C6,,        MOVF    TOTALADIAS,F            ; coloca alarma cercana en cero para decir que no hay alarmas
00000AC6,1903,,        BTFSC   STATUS,Z                ; y sale
00000AC7,0008,,        RETURN
,,,
,,,; Si algun o algunos días esta activado continua
00000AC8,01B2,,        CLRF    NALARMACERCANAF         ; Resetea la bandera de alarma cercana
00000AC9,018A,,        CLRF    PCLATH                  ; Pagina 0
,,,;       CALL    DS1307_Lee              ; Lee la hora actual del DS1307
00000ACA,158A,,        BSF     PCLATH,3                ; Pagina 1
00000ACB,120A,,        BCF     PCLATH,4
00000ACC,01C5,,        CLRF    ULTIMAALARMAD           ; Resetea la bandera de última alarma
,,,
00000ACD,,COMPALARMAS1Y,COMPALARMAS1Y
00000ACD,30FF,,        MOVLW   0xFF                    ; Asigna el valor máximo a las diferencias menores
00000ACE,00B5,,        MOVWF   HORADIFMENOR
00000ACF,00B6,,        MOVWF   MINUTODIFMENOR
00000AD0,00B7,,        MOVWF   MINUTOMENOR
,,,
00000AD1,085C,,        MOVF    DiaSemana,W             ; Inicia con el día de la semana actual
00000AD2,00AA,,        MOVWF   DIAALARMA               ; Guarda día semana en DIAALARMA
00000AD3,30F1,,        MOVLW   EEDDTHLUN               ; Coloca la posición en la eeprom del día
00000AD4,075C,,        ADDWF   DiaSemana,W             ; Lee el tipo de horario del día actual
00000AD5,018A,,        CLRF    PCLATH                  ; Pagina 0
00000AD6,2799,,        CALL    EEDIR
00000AD7,018A,,        CLRF    PCLATH                  ; Pagina 0
00000AD8,279F,,        CALL    EELEER
00000AD9,158A,,        BSF     PCLATH,3                ; Pagina 1
00000ADA,120A,,        BCF     PCLATH,4
00000ADB,00AB,,        MOVWF   VTIPOHORARIO
00000ADC,1D03,,        BTFSS   STATUS,Z
00000ADD,2AE0,,        GOTO    COMPALARMAS1Z           ; Si esta activada continua
00000ADE,22A7,,        CALL    INCDIASEMANA            ; Si ese día esta desactivado incrementa DiaSemana e inicia de n
00000ADF,2ACD,,        GOTO    COMPALARMAS1Y
,,,
,,,
,,,; Si encuentra un día donde esta activada la alarma evelua ese día
00000AE0,,COMPALARMAS1Z,COMPALARMAS1Z
00000AE0,01A5,,        CLRF    NALARMA
00000AE1,0AA5,,        INCF    NALARMA,F
00000AE2,01B1,,        CLRF    NALARMACERCANA          ; Inicializa NALARMACERCANA
,,,
00000AE3,,COMPALARMAS1ZA,COMPALARMAS1ZA
00000AE3,082B,,        MOVF    VTIPOHORARIO,W          ; Multiplica Tipo de Horario por 30 y lo asigna
00000AE4,00A7,,        MOVWF   CONTADOR                ; a NALARMAP, puntero de la alarma
00000AE5,0825,,        MOVF    NALARMA,W
00000AE6,00A6,,        MOVWF   NALARMAP
,,,
00000AE7,,COMPALARMAS1ZB,COMPALARMAS1ZB
00000AE7,0BA7,,        DECFSZ  CONTADOR,F
00000AE8,2AEA,,        GOTO    COMPALARMAS1ZBB
00000AE9,2AED,,        GOTO    COMPALARMAS1
00000AEA,,COMPALARMAS1ZBB,COMPALARMAS1ZBB
00000AEA,301E,,        MOVLW   d'30'
00000AEB,07A6,,        ADDWF   NALARMAP,F
00000AEC,2AE7,,        GOTO    COMPALARMAS1ZB
,,,
00000AED,,COMPALARMAS1,COMPALARMAS1
00000AED,0826,,        MOVF    NALARMAP,W              ; Multiplica por 2 a NALARMA para leer los datos en los
00000AEE,1003,,        BCF     STATUS,C                ; dos registros de la EEPROM
00000AEF,0D26,,        RLF     NALARMAP,W
00000AF0,018A,,        CLRF    PCLATH                  ; Pagina 0
00000AF1,2799,,        CALL    EEDIR
00000AF2,018A,,        CLRF    PCLATH                  ; Pagina 0
00000AF3,279F,,        CALL    EELEER
00000AF4,393F,,        ANDLW   b'00111111'
00000AF5,00A8,,        MOVWF   HORAALARMA              ; Lee hora alarma
00000AF6,1003,,        BCF     STATUS,C
00000AF7,0D26,,        RLF     NALARMAP,W
00000AF8,3E01,,        ADDLW   0x01
00000AF9,018A,,        CLRF    PCLATH                  ; Pagina 0
00000AFA,2799,,        CALL    EEDIR
00000AFB,018A,,        CLRF    PCLATH                  ; Pagina 0
00000AFC,279F,,        CALL    EELEER
00000AFD,158A,,        BSF     PCLATH,3                ; Pagina 1
00000AFE,120A,,        BCF     PCLATH,4
00000AFF,00AD,,        MOVWF   ESTADOALARMA            ; Lee el estado de la alarma
00000B00,397F,,        ANDLW   b'01111111'
00000B01,00A9,,        MOVWF   MINUTOALARMA            ; Lee el minuto de la alarma
,,,
,,,
00000B02,1FAD,,        BTFSS   ESTADOALARMA,7          ; Si la alarma esta apagada
00000B03,2B2E,,        GOTO    COMPALARMAS2            ; continua con otra
,,,
00000B04,085D,,        MOVF    Hora,W
00000B05,0228,,        SUBWF   HORAALARMA,W            ; HORAALARMA - Hora = HORADIF
00000B06,00B3,,        MOVWF   HORADIF
,,,
00000B07,085E,,        MOVF    Minuto,W
00000B08,0229,,        SUBWF   MINUTOALARMA,W          ; MINUTOALARMA - Minuto = MINUTODIF
00000B09,00B4,,        MOVWF   MINUTODIF
,,,
00000B0A,0834,,        MOVF    MINUTODIF,W             ; Si la alarma esta en la hora y minuto actual sigue
00000B0B,0733,,        ADDWF   HORADIF,W               ; con otra alarma
00000B0C,1903,,        BTFSC   STATUS,Z
00000B0D,2B2E,,        GOTO    COMPALARMAS2
,,,
00000B0E,08B3,,        MOVF    HORADIF,F               ; Comprueba si esta en la misma hora
00000B0F,1903,,        BTFSC   STATUS,Z
00000B10,2B20,,        GOTO    COMPALARMAS1B
,,,
00000B11,0835,,        MOVF    HORADIFMENOR,W
00000B12,0233,,        SUBWF   HORADIF,W               ; HORADIF - HORADIFMENOR, si el resultado es negativo
00000B13,1903,,        BTFSC   STATUS,Z                ; Si son iguales, trabaja la misma hora
00000B14,2B19,,        GOTO    COMPALARMAS1A
00000B15,1803,,        BTFSC   STATUS,C                ; HORADIF es menor y Carry es cero
00000B16,2B2E,,        GOTO    COMPALARMAS2            ; Si HORADIF es mayor sigue con otra alarma
00000B17,30FF,,        MOVLW   0xFF
00000B18,00B7,,        MOVWF   MINUTOMENOR
,,,
00000B19,,COMPALARMAS1A,COMPALARMAS1A                           ; No esta en la misma hora, mira el minuto menor
00000B19,0837,,        MOVF    MINUTOMENOR,W
00000B1A,0229,,        SUBWF   MINUTOALARMA,W          ; MINUTOALARMA - MINUTOMENOR
00000B1B,1803,,        BTFSC   STATUS,C                ; Si MINUTOMENOR es mayor a minuto alarma Carry cero
00000B1C,2B2E,,        GOTO    COMPALARMAS2            ; Sigue con otra alarma
00000B1D,0829,,        MOVF    MINUTOALARMA,W          ; Minuto menor es mayor entonces Minuto alarma es
00000B1E,00B7,,        MOVWF   MINUTOMENOR             ; el nuevo minuto menor
00000B1F,2B2A,,        GOTO    COMPALARMAS1C           ; La coloca como la alarma mas cercana
,,,
,,,
00000B20,,COMPALARMAS1B,COMPALARMAS1B
00000B20,085E,,        MOVF    Minuto,W
00000B21,0229,,        SUBWF   MINUTOALARMA,W          ; MINUTOALARMA - Minuto = MINUTODIF
00000B22,1C03,,        BTFSS   STATUS,C                ; Si minuto es mayor a minuto alarma Carry cero
00000B23,2B2E,,        GOTO    COMPALARMAS2
,,,
00000B24,0836,,        MOVF    MINUTODIFMENOR,W
00000B25,0234,,        SUBWF   MINUTODIF,W             ; MINUTODIF - MINUTODIFMENOR, si el resultado es negativo
00000B26,1803,,        BTFSC   STATUS,C                ; MINUTODIF es menor y Carry es cero
00000B27,2B2E,,        GOTO    COMPALARMAS2            ; Si MINUTODIF es mayor sigue con otra alarma
00000B28,0834,,        MOVF    MINUTODIF,W
00000B29,00B6,,        MOVWF   MINUTODIFMENOR
,,,
,,,
,,,
00000B2A,,COMPALARMAS1C,COMPALARMAS1C
00000B2A,0825,,        MOVF    NALARMA,W               ; Si tanto HORADIF como MINUTODIF son los menores
00000B2B,00B1,,        MOVWF   NALARMACERCANA          ; entonces NALARMA es NALARMACERCANA
00000B2C,0833,,        MOVF    HORADIF,W
00000B2D,00B5,,        MOVWF   HORADIFMENOR
,,,
,,,
00000B2E,,COMPALARMAS2,COMPALARMAS2
,,,
00000B2E,0AA5,,        INCF    NALARMA,F
00000B2F,301F,,        MOVLW   d'31'
00000B30,0225,,        SUBWF   NALARMA,W
00000B31,1D03,,        BTFSS   STATUS,Z                ; Si NALARMA es 31 termina
00000B32,2AE3,,        GOTO    COMPALARMAS1ZA          ; Si no continua con la siguiente alarma
,,,
00000B33,0831,,        MOVF    NALARMACERCANA,W
00000B34,00A5,,        MOVWF   NALARMA
,,,
00000B35,08B1,,        MOVF    NALARMACERCANA,F        ; Comprueba si no hubo alarmas cercanas
00000B36,1D03,,        BTFSS   STATUS,Z                ; Comprueba si NALARMACERCANA es igual a 0x00
00000B37,2B3E,,        GOTO    COMPALARMAS2A           ; Si hay alguna alarma cercana continua
00000B38,08B2,,        MOVF    NALARMACERCANAF,F       ; Comprueba la bandera si ya se paso por aqui
00000B39,1D03,,        BTFSS   STATUS,Z
00000B3A,2B3E,,        GOTO    COMPALARMAS2A           ; Si ya se paso continua
00000B3B,0AB2,,        INCF    NALARMACERCANAF,F
00000B3C,0ADD,,        INCF    Hora,F                  ; Si no hay alarmas cercanas incrementa la hora y vuelve a
00000B3D,2ACD,,        GOTO    COMPALARMAS1Y           ; comparar sin leer la hora
,,,
00000B3E,,COMPALARMAS2A,COMPALARMAS2A
,,,
00000B3E,,COMPALARMAS2AA,COMPALARMAS2AA
00000B3E,082B,,        MOVF    VTIPOHORARIO,W          ; Multiplica Tipo de Horario por 30 y lo asigna
00000B3F,00A7,,        MOVWF   CONTADOR                ; a NALARMAP, puntero de la alarma
00000B40,0825,,        MOVF    NALARMA,W
00000B41,00A6,,        MOVWF   NALARMAP
,,,
00000B42,,COMPALARMAS2AB,COMPALARMAS2AB
00000B42,0BA7,,        DECFSZ  CONTADOR,F
00000B43,2B45,,        GOTO    COMPALARMAS2ABB
00000B44,2B48,,        GOTO    COMPALARMAS2ACC
00000B45,,COMPALARMAS2ABB,COMPALARMAS2ABB
00000B45,301E,,        MOVLW   d'30'
00000B46,07A6,,        ADDWF   NALARMAP,F
00000B47,2B42,,        GOTO    COMPALARMAS2AB
,,,
00000B48,,COMPALARMAS2ACC,COMPALARMAS2ACC
00000B48,0826,,        MOVF    NALARMAP,W
00000B49,1003,,        BCF     STATUS,C
00000B4A,0D26,,        RLF     NALARMAP,W
00000B4B,018A,,        CLRF    PCLATH                  ; Pagina 0
00000B4C,2799,,        CALL    EEDIR
00000B4D,018A,,        CLRF    PCLATH                  ; Pagina 0
00000B4E,279F,,        CALL    EELEER
00000B4F,00AE,,        MOVWF   TIPOTIMBRE
00000B50,393F,,        ANDLW   b'00111111'
00000B51,00A8,,        MOVWF   HORAALARMA
00000B52,1003,,        BCF     STATUS,C
00000B53,0D26,,        RLF     NALARMAP,W
00000B54,3E01,,        ADDLW   0x01
00000B55,018A,,        CLRF    PCLATH                  ; Pagina 0
00000B56,2799,,        CALL    EEDIR
00000B57,018A,,        CLRF    PCLATH                  ; Pagina 0
00000B58,279F,,        CALL    EELEER
00000B59,00AD,,        MOVWF   ESTADOALARMA
00000B5A,397F,,        ANDLW   b'01111111'
00000B5B,00A9,,        MOVWF   MINUTOALARMA
00000B5C,082E,,        MOVF    TIPOTIMBRE,W
00000B5D,018A,,        CLRF    PCLATH                  ; Pagina 0
00000B5E,2513,,        CALL    ROTAR6D
00000B5F,158A,,        BSF     PCLATH,3                ; Pagina 1
00000B60,120A,,        BCF     PCLATH,4
00000B61,00AE,,        MOVWF   TIPOTIMBRE
,,,
,,,
00000B62,3008,,        MOVLW   d'8'                    ; Si se ha incrementado mas de 8 veces el día sale
00000B63,0245,,        SUBWF   ULTIMAALARMAD,W
00000B64,1903,,        BTFSC   STATUS,Z
00000B65,0008,,        RETURN
,,,
00000B66,08A5,,        MOVF    NALARMA,F               ; Si no hay alarmas cercanas sigue con otro día
00000B67,1D03,,        BTFSS   STATUS,Z
00000B68,2B6C,,        GOTO    COMPALARMAS2B
00000B69,22A7,,        CALL    INCDIASEMANA
00000B6A,0AC5,,        INCF    ULTIMAALARMAD,F         ; Saber cuantas veces se ha incrementado el día
00000B6B,2ACD,,        GOTO    COMPALARMAS1Y           ; Continual con el día desde el principio
,,,
00000B6C,,COMPALARMAS2B,COMPALARMAS2B
,,,
,,,
00000B6C,085D,,        MOVF    Hora,W
00000B6D,0228,,        SUBWF   HORAALARMA,W            ; HORAALARMA - Hora = HORADIF
00000B6E,00B3,,        MOVWF   HORADIF
00000B6F,1903,,        BTFSC   STATUS,Z
00000B70,2B78,,        GOTO    COMPALARMAS3
,,,
00000B71,0833,,        MOVF    HORADIF,W               ; HORADIF - 0xD0
00000B72,3CD0,,        SUBLW   0xD0
00000B73,1803,,        BTFSC   STATUS,C
00000B74,0008,,        RETURN                          ; HORADIF < 0xD0 No es la última hora del día
00000B75,22A7,,        CALL    INCDIASEMANA            ; HORADIF > 0xD0, es la última alarma del día, incrementa el día
00000B76,0AC5,,        INCF    ULTIMAALARMAD,F         ; Saber cuantas veces se ha incrementado el día
00000B77,2ACD,,        GOTO    COMPALARMAS1Y           ; Continual con el día desde el principio
,,,
,,,
,,,
00000B78,,COMPALARMAS3,COMPALARMAS3
,,,
00000B78,085E,,        MOVF    Minuto,W
00000B79,0229,,        SUBWF   MINUTOALARMA,W          ; MINUTOALARMA - Minuto = MINUTODIF
00000B7A,00B4,,        MOVWF   MINUTODIF
,,,
,,,
00000B7B,0834,,        MOVF    MINUTODIF,W             ; MINUTODIF - 0xA0
00000B7C,3CA0,,        SUBLW   0xA0
00000B7D,1803,,        BTFSC   STATUS,C
00000B7E,0008,,        RETURN                          ; MINUTODIF < 0xA0 es un minuto posterior al actual con hora igu
00000B7F,22A7,,        CALL    INCDIASEMANA            ; MINUTODIF > 0xA0, es es un minuto anterior al actual con hora
00000B80,1445,,        BSF     ULTIMAALARMAD,0         ; Activa la bandera de ultima alarma
00000B81,2ACD,,        GOTO    COMPALARMAS1Y           ; Continual con el día desde el principio
,,,
,,,
,,,
00000B82,,ANTESDELOGO,ANTESDELOGO
,,,        IF (ANTESDELOGO > 0xDFE)
,,,                ERROR   "Atención: Se interrumpe con el logo"
,,,                MESSG   "de la direccion 0xE00"
,,,        ENDIF
,,,; LOGO**** *********************************************************************************************
,,,
,,,
00000E01,,,        ORG     0xE01
,,,
00000E01,,LCD_DIBLOGORET,LCD_DIBLOGORET
00000E01,0782,,        ADDWF   PCL,F
,,,
