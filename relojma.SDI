,,,;**************************************** relojma.asm **************************************************
,,,
,,,
,,,; ZONA DE DATOS ****************************************************************************************
,,,
,,,
00002007,1F75,,        __CONFIG _CP_ALL & _WDT_ON & _BODEN_ON & _PWRTE_ON & _XT_OSC & _LVP_OFF & _CPD_OFF
,,,        ; Configuración del microcontrolador
,,,
,,,        LIST     P=16F877A              ; Procesador utilizado.
,,,        INCLUDE  <P16F877A.INC>         ; En este fichero se definen las etiquetas del PIC.
,,,
,,,        CBLOCK  0x20
,,,        NMENU
,,,        DATOTECLA
,,,        TEMPS
,,,        TEMPW
,,,        AMPM
,,,        NALARMA
,,,        NALARMAP
,,,        CONTADOR
,,,        HORAALARMA
,,,        MINUTOALARMA
,,,        DIAALARMA
,,,        VTIPOHORARIO
,,,        VTIPOHORARIO2
,,,        ESTADOALARMA
,,,        TIPOTIMBRE
,,,        TEMPROTAR
,,,        CONTROTAR
,,,        NALARMACERCANA
,,,        NALARMACERCANAF
,,,        HORADIF
,,,        MINUTODIF
,,,        HORADIFMENOR
,,,        MINUTODIFMENOR
,,,        MINUTOMENOR
,,,        CONTLEDLCD
,,,        TEMPHORA
,,,        PASSWA
,,,        PASSWB
,,,        PASSWA1
,,,        PASSWB1
,,,        CONTTECLADOWW
,,,        ESTADOCONTRASENA
,,,        DTIMBREC
,,,        DTIMBREL
,,,        SONADAALARMAMF
,,,        MENDIAV
,,,        CONTDIATH
,,,        ULTIMAALARMAD
,,,        TOTALADIAS
,,,        TEMPTECLAP
,,,        ENDC
,,,
,,,TARRIBA EQU     0x0E
,,,TABAJO  EQU     0x0D
,,,TENTER  EQU     0x0F
,,,TMENU   EQU     0x0C
,,,TAST    EQU     0x0A
,,,TNUM    EQU     0x0B
,,,
,,,
,,,#DEFINE  PINTIMBRE      PORTC,0                 ; Timbre por el puerto C bit 0 pin 15
,,,#DEFINE  PINLEDLCD      PORTC,1                 ; Pin para la luz de fondo del LCD
,,,#DEFINE  TIEMPOLCD      d'20'                   ; Define el tiempo en n*500ms de la duración
,,,                                                ; de la luz del LCD
,,,#DEFINE  EEDDCONH       0xFE                    ; Direcciones donde se almacena la contraseña
,,,#DEFINE  EEDDCONB       0xFF
,,,#DEFINE  EEDDESTACON    0xFD                    ; Dirección del estado de la contraseña
,,,#DEFINE  EEDDTIMBREC    0xFB                    ; Direcciones en la EPROM para la duracion de timbres
,,,#DEFINE  EEDDTIMBREL    0xFC
,,,#DEFINE  EEDDTHLUN      0xF1                    ; El día lunes esta en la dirección F2 porque Lunes es 1
,,,                                                ; Domingo en la dirección F8, días de F2-F8
,,,
,,,
,,,; ZONA DE CÓDIGOS **************************************************************************************
,,,
,,,        ORG     0
00000000,2866,,        GOTO    INICIO
,,,        ORG     4
00000004,2891,,        GOTO    INTERRPUCION
,,,
,,,        INCLUDE "D:\Electronica\RelojMA\Librerias\TECLADO.INC"
,,,;**************************** Librería "TECLADO.INC" ***********************************
,,,;
,,,;       ===================================================================
,,,;         Del libro "MICROCONTROLADOR PIC16F84. DESARROLLO DE PROYECTOS"
,,,;         E. Palacios, F. Remiro y L. López.
,,,;         Editorial Ra-Ma.  www.ra-ma.es
,,,;       ===================================================================
,,,;
,,,; Librería de subrutinas para la gestión de un teclado organizado en una matriz de 4 x 4 y
,,,; conectado al Puerto B según la disposición siguiente y explicada en la figura 19-2 del libro:
,,,;
,,,;                RB4 RB5 RB6 RB7
,,,;                  ^    ^    ^    ^
,,,;               |----|----|----|----|
,,,;       RA0 --> |  0 |  1 |  2 |  3 |
,,,;               |----|----|----|----|
,,,;       RB1 --> |  4 |  5 |  6 |  7 |
,,,;               |----|----|----|----|
,,,;       RB2 --> |  8 |  9 | 10 | 11 |
,,,;               |----|----|----|----|
,,,;       RB3 --> | 12 | 13 | 14 | 15 |
,,,;               |----|----|----|----|
,,,;
,,,; Los números que se han dibujado dentro de cada cuadrado son el orden de las teclas
,,,; que no tienen por qué coincidir con lo serigrafiado sobre ellas. El paso del número de orden
,,,; de la tecla al valor que hay serigrafiado sobre la misma se hace con una tabla de conversión.
,,,;
,,,; ZONA DE DATOS **********************************************************************
,,,;
,,,        CBLOCK
,,,        Tecl_TeclaOrden                 ; Orden de la tecla a chequear.
,,,        TPORTB
,,,        TEMPTECLADO
,,,        MAXTECLADO
,,,        ENDC
,,,
,,,Tecl_UltimaTecla        EQU     d'15'           ; Valor de orden de la última tecla utilizada.
,,,
,,,; Subrutina "Teclado_LeeHex" ************************************************************
,,,;
,,,; Cada tecla tiene asignado un número de orden que es contabilizado en la variable
,,,; Tecl_TeclaOrden. Para convertir a su valor según el tipo de teclado en concreto se
,,,; utiliza una tabla de conversión.
,,,; A continuación se expone la relación entre el número de orden de la tecla y los
,,,; valores correspondientes para el teclado hexadecimal más utilizado.
,,,;
,,,;           ORDEN DE TECLA:             TECLADO HEX. UTILIZADO:
,,,;                0   1   2   3                  1  2  3  F
,,,;                4   5   6   7                  4  5  6  E
,,,;                8   9  10  11                  7  8  9  D
,,,;               12  13  14  15                  A  0  B  C
,,,;
,,,; Así, en este ejemplo, la tecla "7" ocupa el orden 8, la tecla "F" ocupa el orden 3 y la
,,,; tecla "9" el orden 10.
,,,
,,,; Si cambia el teclado también hay cambiar de tabla de conversión.
,,,;
,,,; Entrada:      En (W) el orden de la tecla pulsada.
,,,; Salida:       En (W) el valor hexadecimal para este teclado concreto.
,,,;
00000005,,Teclado_LeeHex,Teclado_LeeHex
00000005,2034,,        call    Teclado_LeeOrdenTecla   ; Lee el Orden de la tecla pulsada.
00000006,1C03,,        btfss   STATUS,C                ; ¿Pulsa alguna tecla?, ¿C=1?
00000007,280A,,        goto    Tecl_FinLeeHex          ; No, por tanto sale.
00000008,200B,,        call    Tecl_ConvierteOrdenEnHex        ; Lo convierte en su valor real mediante tabla.
00000009,1403,,        bsf     STATUS,C                ; Vuelve a posicionar el Carry, porque la
0000000A,,Tecl_FinLeeHex,Tecl_FinLeeHex                          ; instrucción "addwf PCL,F" lo pone a "0".
0000000A,0008,,        return
,,,;
0000000B,,Tecl_ConvierteOrdenEnHex,Tecl_ConvierteOrdenEnHex                        ; Según el teclado utilizado resulta:
0000000B,0782,,        addwf   PCL,F
0000000C,3401 3402 3403,,        DT      1h,2h,3h,0Fh            ; Primera fila del teclado.
00000010,3404 3405 3406,,        DT      4h,5h,6h,0Eh            ; Segunda fila del teclado
00000014,3407 3408 3409,,        DT      7h,8h,9h,0Dh            ; Tercera fila del teclado.
00000018,340A 3400 340B,,        DT      0Ah,0h,0Bh,0Ch          ; Cuarta fila del teclado.
0000001C,,Teclado_FinTablaHex,Teclado_FinTablaHex
,,,;
,,,; Esta tabla se sitúa al principio de la librería con el propósito de que no supere la
,,,; posición 0FFh de memoria ROM de programa. De todas formas, en caso que así fuera
,,,; visualizaría el siguiente mensaje de error en el proceso de ensamblado:
,,,;
,,,        IF (Teclado_FinTablaHex > 0xFF)
,,,                ERROR   "Atención: La tabla ha superado el tamaño de la página de los"
,,,                MESSG   "primeros 256 bytes de memoria ROM. NO funcionará correctamente."
,,,        ENDIF
,,,
,,,; Subrutina "Teclado_Inicializa" --------------------------------------------------------
,,,;
,,,; Esta subrutina configura las líneas del Puerto B según la conexión del teclado realizada
,,,; y comprueba que no hay pulsada tecla alguna al principio.
,,,
0000001C,,Teclado_Inicializa,Teclado_Inicializa
0000001C,1683,,        bsf     STATUS,RP0              ; Configura las líneas del puerto:
0000001D,1005,,        BCF     PORTA,0
0000001E,1086,,        BCF     PORTB,1
0000001F,1106,,        BCF     PORTB,2
00000020,1186,,        BCF     PORTB,3
00000021,1606,,        BSF     PORTB,4
00000022,1686,,        BSF     PORTB,5
00000023,1706,,        BSF     PORTB,6
00000024,1786,,        BSF     PORTB,7
00000025,1381,,        bcf     OPTION_REG,NOT_RBPU     ; Habilita resistencia de Pull-Up del Puerto B.
00000026,1283,,        bcf     STATUS,RP0              ; Acceso al banco 0.
,,,;       call    Teclado_EsperaDejePulsar
,,,;       return
,,,;
,,,; Subrutina "Teclado_EsperaDejePulsar" --------------------------------------------------
,,,;
,,,;Permanece en esta subrutina mientras siga pulsada la tecla.
,,,;
,,,Teclado_Comprobacion    EQU     b'11110000'
,,,
00000027,,Teclado_EsperaDejePulsar:,Teclado_EsperaDejePulsar:
00000027,1005,,        BCF     PORTA,0
00000028,1086,,        BCF     PORTB,1
00000029,1106,,        BCF     PORTB,2
0000002A,1186,,        BCF     PORTB,3
0000002B,30F0,,        movlw   Teclado_Comprobacion    ; Pone a cero las cuatro líneas de salida del
0000002C,0086,,        movwf   PORTB                   ; Puerto B.
0000002D,,Teclado_SigueEsperando,Teclado_SigueEsperando
0000002D,26D6,,        call    Retardo_20ms            ; Espera a que se estabilicen los niveles de tensión.
0000002E,0806,,        movf    PORTB,W         ; Lee el Puerto B.
0000002F,39F0,,        andlw   b'11110000'
00000030,3CF0,,        sublw   Teclado_Comprobacion    ; Si es lo mismo que escribió es que ya no pulsa
00000031,1D03,,        btfss   STATUS,Z                ; tecla alguna.
00000032,282D,,        goto    Teclado_SigueEsperando
00000033,0008,,        return
,,,;
,,,; Subrutina "Teclado_LeeOrdenTecla" -----------------------------------------------------
,,,;
,,,; Lee el teclado, obteniendo el orden de la tecla pulsada.
,,,;
,,,; Salida:       En (W) el número de orden de la tecla pulsada. Además Carry se pone a "1" si
,,,;               se pulsa una tecla ó a "0" si no se pulsa tecla alguna. q
,,,;
00000034,,Teclado_LeeOrdenTecla:,Teclado_LeeOrdenTecla:
00000034,01C8,,        clrf    Tecl_TeclaOrden         ; Todavía no ha empezado a chequear el teclado.
00000035,30FE,,        movlw   b'11111110'             ; Va a chequear primera fila.
00000036,00C9,,        movwf   TPORTB
00000037,,Tecl_ChequeaFila,Tecl_ChequeaFila
00000037,1005,,        BCF     PORTA,0
00000038,1849,,        BTFSC   TPORTB,0
00000039,1405,,        BSF     PORTA,0                         ; (Ver esquema de conexión).
0000003A,0849,,        MOVF    TPORTB,W
0000003B,0086,,        movwf   PORTB                   ; Activa la fila correspondiente.
0000003C,,Tecl_Columna1,Tecl_Columna1
0000003C,1E06,,        btfss   PORTB,4                 ; Chequea la 1ª columna buscando un cero.
0000003D,2851,,        goto    Tecl_GuardaValor                ; Sí, es cero y por tanto guarda su valor y sale.
0000003E,0AC8,,        incf    Tecl_TeclaOrden,F               ; Va a chequear la siguiente tecla.
0000003F,,Tecl_Columna2,Tecl_Columna2                           ; Repite proceso para las siguientes
0000003F,1E86,,        btfss   PORTB,5                 ; columnas.
00000040,2851,,        goto    Tecl_GuardaValor
00000041,0AC8,,        incf    Tecl_TeclaOrden,F
00000042,,Tecl_Columna3,Tecl_Columna3
00000042,1F06,,        btfss   PORTB,6
00000043,2851,,        goto    Tecl_GuardaValor
00000044,0AC8,,        incf    Tecl_TeclaOrden,F
00000045,,Tecl_Columna4,Tecl_Columna4
00000045,1F86,,        btfss   PORTB,7
00000046,2851,,        goto    Tecl_GuardaValor
00000047,0AC8,,        incf    Tecl_TeclaOrden,F
,,,;
,,,; Comprueba si ha chequeado la última tecla, en cuyo caso sale. Para ello testea si
,,,; el contenido del registro Tecl_TeclaOrden es igual al número de teclas del teclado.
,,,;
00000048,,Tecl_TerminaColumnas,Tecl_TerminaColumnas
00000048,300F,,        movlw   Tecl_UltimaTecla
00000049,0248,,        subwf   Tecl_TeclaOrden,W               ; (W) = (Tecl_TeclaOrden)-Tecl_UltimaTecla.
0000004A,1803,,        btfsc   STATUS,C                ; ¿C=0?, ¿(W) negativo?, ¿(Tecl_TeclaOrden)<15?
0000004B,284F,,        goto    Tecl_NoPulsada          ; No, se ha llegado al final del chequeo.
0000004C,1403,,        bsf     STATUS,C                ; Sí. Va a chequear la siguiente fila.
0000004D,0DC9,,        rlf     TPORTB,F                ; Apunta a la siguiente fila.
0000004E,2837,,        goto    Tecl_ChequeaFila
0000004F,,Tecl_NoPulsada,Tecl_NoPulsada
0000004F,1003,,        bcf     STATUS,C                ; Posiciona C=0, indicando que no ha pulsado
00000050,2853,,        goto    Tecl_FinTecladoLee      ; tecla alguna y sale.
00000051,,Tecl_GuardaValor,Tecl_GuardaValor
00000051,0848,,        movf    Tecl_TeclaOrden,W               ; El orden de la tecla pulsada en (W) y sale.
00000052,1403,,        bsf     STATUS,C                ; Como hay tecla tecla pulsada, pone C=1.
00000053,,Tecl_FinTecladoLee,Tecl_FinTecladoLee
00000053,0008,,        return
,,,
,,,;       ===================================================================
,,,;         Del libro "MICROCONTROLADOR PIC16F84. DESARROLLO DE PROYECTOS"
,,,;         E. Palacios, F. Remiro y L. López.
,,,;         Editorial Ra-Ma.  www.ra-ma.es
,,,;       ===================================================================
,,,
,,,
00000054,,Teclado_LeeHexw,Teclado_LeeHexw                         ; Espera a que se leea y pasa el dato a W
00000054,0064,,        CLRWDT                          ; Resetea el WDT
00000055,2005,,        CALL    Teclado_LeeHex
00000056,1C03,,        BTFSS   STATUS,C
00000057,2854,,        GOTO    Teclado_LeeHexw
00000058,00CA,,        MOVWF   TEMPTECLADO
00000059,2027,,        CALL    Teclado_EsperaDejePulsar
0000005A,084A,,        MOVF    TEMPTECLADO,W
0000005B,0008,,        RETURN
,,,
0000005C,,Teclado_Leemax,Teclado_Leemax
0000005C,3E01,,        ADDLW   d'1'
0000005D,00CB,,        MOVWF   MAXTECLADO
0000005E,,Teclado_Leemaxa,Teclado_Leemaxa
0000005E,2054,,        CALL    Teclado_LeeHexw
0000005F,00CA,,        MOVWF   TEMPTECLADO
00000060,084B,,        MOVF    MAXTECLADO,W
00000061,024A,,        SUBWF   TEMPTECLADO,W
00000062,1803,,        BTFSC   STATUS,C
00000063,285E,,        GOTO    Teclado_Leemaxa
00000064,084A,,        MOVF    TEMPTECLADO,W
00000065,0008,,        RETURN
,,,
,,,
,,,
,,,
00000066,,INICIO,INICIO
,,,;       MOVLW   0x18
,,,;       MOVWF   Hora
,,,;       MOVLW   0x32
,,,;       MOVWF   Minuto
,,,;       MOVLW   0x02
,,,;       MOVWF   DiaSemana
00000066,158A,,        BSF     PCLATH,3                ; Pagina 1
00000067,120A,,        BCF     PCLATH,4
00000068,22B4,,        CALL    COMPALARMAS
00000069,018A,,        CLRF    PCLATH                  ; Pagina 0
,,,
0000006A,1007,,        BCF     PINTIMBRE               ; Se asegura que el timbre esta apagado
0000006B,201C,,        CALL    Teclado_Inicializa      ; Configura las líneas del teclado.
,,,
0000006C,1683,,        BSF     STATUS,RP0              ; Pone a 1 el bit 5 del STATUS. Acceso al Banco 1.
0000006D,3007,,        MOVLW   0x07                    ; Todas las entradas digitales
0000006E,009F,,        MOVWF   ADCON1
0000006F,1701,,        BSF     OPTION_REG,INTEDG       ; Interrupción INT de RB0 activada por flanco de bajada.
00000070,1581,,        BSF     OPTION_REG,PSA          ; Preescaler asignado al WDT
00000071,1401,,        BSF     OPTION_REG,PS0          ; Preescaler en 1:128 x 18ms
00000072,1481,,        BSF     OPTION_REG,PS1
00000073,1501,,        BSF     OPTION_REG,PS2
00000074,1406,,        BSF     PORTB,0                 ; Coloca al RB0 como entrada
00000075,1085,,        BCF     PORTA,1
00000076,1007,,        BCF     PINTIMBRE               ; Coloca al pin del timbre como salida
00000077,1087,,        BCF     PINLEDLCD               ; Coloca el pin de la luz de fondo del LCD como salida
00000078,1283,,        BCF     STATUS,RP0
00000079,25AE,,        CALL    LCD_Inicializa          ; Inicializa la pantalla y graba el logo en su memoria
0000007A,2754,,        CALL    DS1307_Inicializa
,,,
0000007B,275D,,        CALL    DS1307_Lee              ; Lee los segundos en el DS1307 y comprueba el
0000007C,1FDF,,        BTFSS   Segundo,7               ; valor del bit CH. Si es "1" salta toda la
0000007D,2883,,        GOTO    INICIO2                 ; inicialización de los registros y la puesta
,,,                                        ; en hora inicial.
0000007E,277A,,        call    DS1307_CargaInicial     ; Realiza la carga inicial
0000007F,30FD,,        MOVLW   EEDDESTACON             ; Dirección de estado de la contraseña
00000080,2799,,        CALL    EEDIR
00000081,0103,,        CLRW                            ; Cuando se quita la pila
00000082,27AA,,        CALL    EEESCRIBIR              ; Deshabilita la contraseña
,,,
,,,
,,,
00000083,,INICIO2,INICIO2
00000083,1487,,        BSF     PINLEDLCD
00000084,158A,,        BSF     PCLATH,3                ; Pagina 1
00000085,120A,,        BCF     PCLATH,4
00000086,22B4,,        CALL    COMPALARMAS             ; Compara las alamras
00000087,018A,,        CLRF    PCLATH                  ; Pagina 0
00000088,2130,,        CALL    ARELOJ                  ; Actualiza la hora
,,,
00000089,3098,,        MOVLW   b'10011000'             ; Habilita la interrupción INT de RB0, RBI y la general.
0000008A,008B,,        MOVWF   INTCON
0000008B,1007,,        BCF     PINTIMBRE
0000008C,3014,,        MOVLW   TIEMPOLCD
0000008D,00B8,,        MOVWF   CONTLEDLCD
0000008E,01C2,,        CLRF    SONADAALARMAMF
,,,
,,,
0000008F,,PRINCIPAL,PRINCIPAL
0000008F,0063,,        SLEEP
00000090,288F,,        GOTO    PRINCIPAL
,,,
,,,
,,,; ZONA DE INTERRUPCION *********************************************************************************
00000091,,INTERRPUCION,INTERRPUCION
00000091,00A3,,        MOVWF   TEMPW
00000092,0E03,,        SWAPF   STATUS,W
00000093,00A2,,        MOVWF   TEMPS
,,,
00000094,188B,,        BTFSC   INTCON,INTF             ; Interrupción del reloj
00000095,2130,,        CALL    ARELOJ                  ; Actualiza la hora
00000096,188B,,        BTFSC   INTCON,INTF             ; Interrupción del reloj
00000097,2525,,        CALL    TESTEARALARMA
,,,
00000098,180B,,        BTFSC   INTCON,RBIF             ; Interrupción del teclado
00000099,28A1,,        GOTO    ITECLADO
,,,
0000009A,,FININTERRUPCION,FININTERRUPCION
0000009A,0E22,,        SWAPF   TEMPS,W                 ; Devuelve las variableds
0000009B,0083,,        MOVWF   STATUS
0000009C,0EA3,,        SWAPF   TEMPW,F
0000009D,0E23,,        SWAPF   TEMPW,W
,,,
0000009E,100B,,        BCF     INTCON,RBIF             ; Resetea las banderas de interrupción
0000009F,108B,,        BCF     INTCON,INTF
000000A0,0009,,        RETFIE
,,,
,,,
,,,; ZONA DE SUBRUTINAS ***********************************************************************************
,,,
,,,; INTERRUPCIÓN POR TECLADO *****************************************************************************
000000A1,,ITECLADO,ITECLADO
000000A1,2005,,        CALL    Teclado_LeeHex                  ; Obtiene el valor hexadecimal de la tecla pulsada.
000000A2,00C7,,        MOVWF   TEMPTECLAP
,,,
000000A3,1487,,        BSF     PINLEDLCD                       ; Enciende la luz de fondo del LCD
000000A4,3014,,        MOVLW   TIEMPOLCD                       ; Inicilaliza el contador de luz LCD
000000A5,00B8,,        MOVWF   CONTLEDLCD
,,,
000000A6,0847,,        MOVF    TEMPTECLAP,W
000000A7,3C0C,,        SUBLW   TMENU
000000A8,1903,,        BTFSC   STATUS,Z
000000A9,28B4,,        GOTO    ITECLADOA                       ; Si se pulso la tecla Menu va a ITECLADOA
,,,
000000AA,0847,,        MOVF    TEMPTECLAP,W
000000AB,3C0B,,        SUBLW   TNUM
000000AC,1D03,,        BTFSS   STATUS,Z
000000AD,2928,,        GOTO    FINITECLADO                     ; Si no se pulso el Numeral va a FINITECLADO
,,,
000000AE,1407,,        BSF     PINTIMBRE                       ; Timbra
000000AF,23D9,,        CALL    MRINGON
000000B0,26D2,,        CALL    Retardo_100ms
000000B1,2027,,        CALL    Teclado_EsperaDejePulsar        ; Para que no se repita el mismo carácter
000000B2,1007,,        BCF     PINTIMBRE                       ; Apaga el timbre
000000B3,2928,,        GOTO    FINITECLADO                     ; Va a fin teclado
,,,
,,,
,,,
000000B4,,ITECLADOA,ITECLADOA
000000B4,2027,,        CALL    Teclado_EsperaDejePulsar        ; Para que no se repita el mismo carácter
000000B5,25AE,,        CALL    LCD_Inicializa                  ; Inicializa la pantalla y graba el logo en su memoria
000000B6,26A9,,        CALL    LCD_Borra
,,,
000000B7,30FD,,        MOVLW   EEDDESTACON                     ; Comprueba si el sistema piede o no contraseña
000000B8,2799,,        CALL    EEDIR
000000B9,279F,,        CALL    EELEER
000000BA,00BF,,        MOVWF   ESTADOCONTRASENA
000000BB,1C3F,,        BTFSS   ESTADOCONTRASENA,0
000000BC,28E0,,        GOTO    ITECLADO1
,,,
000000BD,26A9,,        CALL    LCD_Borra                       ; Pide la contraseña
000000BE,23C4,,        CALL    MCONTRASENA
000000BF,25F1,,        CALL    LCD_Linea2
000000C0,30FF,,        MOVLW   0xFF
000000C1,00BE,,        MOVWF   CONTTECLADOWW
,,,
000000C2,259C,,        CALL    Teclado_LeeHexww
000000C3,00BA,,        MOVWF   PASSWA
000000C4,0EBA,,        SWAPF   PASSWA,F
000000C5,302A,,        MOVLW   '*'
000000C6,2608,,        CALL    LCD_Caracter
000000C7,259C,,        CALL    Teclado_LeeHexww
000000C8,07BA,,        ADDWF   PASSWA,F
000000C9,302A,,        MOVLW   '*'
000000CA,2608,,        CALL    LCD_Caracter
,,,
000000CB,259C,,        CALL    Teclado_LeeHexww
000000CC,00BB,,        MOVWF   PASSWB
000000CD,0EBB,,        SWAPF   PASSWB,F
000000CE,302A,,        MOVLW   '*'
000000CF,2608,,        CALL    LCD_Caracter
000000D0,259C,,        CALL    Teclado_LeeHexww
000000D1,07BB,,        ADDWF   PASSWB,F
000000D2,302A,,        MOVLW   '*'
000000D3,2608,,        CALL    LCD_Caracter
,,,
000000D4,30FE,,        MOVLW   EEDDCONH                                ; Comprueba la contraseña
