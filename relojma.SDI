00000597,0840,,        MOVF    DTIMBREC,W
00000598,2701,,        CALL    Retardo_wseg
00000599,1007,,        BCF     PINTIMBRE
0000059A,23EC,,        CALL    MRINGOFF
0000059B,2D5F,,        GOTO    TESTEARALARMAFIN
,,,
,,,
,,,
0000059C,,Teclado_LeeHexww,Teclado_LeeHexww
0000059C,08BE,,        MOVF    CONTTECLADOWW,F
0000059D,1903,,        BTFSC   STATUS,Z
0000059E,2DAC,,        GOTO    Teclado_LeeHexwwe
,,,
0000059F,,Teclado_LeeHexww1,Teclado_LeeHexww1
0000059F,0064,,        CLRWDT
000005A0,26D6,,        CALL    Retardo_20ms
000005A1,03BE,,        DECF    CONTTECLADOWW,F
000005A2,1903,,        BTFSC   STATUS,Z
000005A3,2DAC,,        GOTO    Teclado_LeeHexwwe
,,,
000005A4,2005,,        CALL    Teclado_LeeHex
000005A5,1C03,,        BTFSS   STATUS,C
000005A6,2D9F,,        GOTO    Teclado_LeeHexww1
000005A7,00CA,,        MOVWF   TEMPTECLADO
000005A8,2027,,        CALL    Teclado_EsperaDejePulsar
000005A9,084A,,        MOVF    TEMPTECLADO,W
000005AA,390F,,        ANDLW   0x0F
000005AB,0008,,        RETURN
,,,
000005AC,,Teclado_LeeHexwwe,Teclado_LeeHexwwe
000005AC,300F,,        MOVLW   0x0F
000005AD,0008,,        RETURN
,,,
,,,
,,,
,,,; ZONA DE LIBRERIAS ************************************************************************************
,,,
,,,        INCLUDE "D:\Electronica\RelojMA\Librerias\LCD_4BITOPD877.INC"
,,,;**************************** Librería "LCD_4BIT.INC" ***********************************
,,,;
,,,;       ===================================================================
,,,;         Del libro "MICROCONTROLADOR PIC16F84. DESARROLLO DE PROYECTOS"
,,,;         E. Palacios, F. Remiro y L. López.
,,,;         Editorial Ra-Ma.  www.ra-ma.es
,,,;       ===================================================================
,,,;
,,,; Estas subrutinas permiten realizar las tareas básicas de control de un módulo LCD de 2
,,,; líneas por 16 caracteres, compatible con el modelo LM016L.
,,,;
,,,; El visualizador LCD está conectado al Puerto B del PIC mediante un bus de 4 bits. Las
,,,; conexiones son:
,,,;    -  Las 4 líneas superiores del módulo LCD, pines <DB7:DB4>  se conectan a las 4
,,,;       líneas superiores del Puerto B del PIC, pines <RB7:RB4>.
,,,;    -  Pin RS del LCD a la línea RA0 del PIC.
,,,;    -  Pin R/W del LCD a la línea RA1 del PIC, o a masa.
,,,;    -  Pin Enable del LCD a la línea RA2 del PIC.
,,,;
,,,; Se utilizan llamadas a subrutinas de retardo de tiempo localizadas en la librería RETARDOS.INC.
,,,;
,,,; ZONA DE DATOS *********************************************************************
,,,
,,,        CBLOCK
,,,        LCD_Dato
,,,        LCD_GuardaDato
,,,        LCD_Auxiliar1
,,,        LCD_Auxiliar2
,,,        LCD_TEMP
,,,        LCD_TEMPRS
,,,        ENDC
,,,
,,,LCD_CaracteresPorLinea  EQU     .16     ; Número de caracteres por línea de la pantalla.
,,,
,,,#DEFINE  LCD_PinRS      PORTD,1
,,,#DEFINE  LCD_PinRW      PORTD,2
,,,#DEFINE  LCD_PinEnable  PORTD,3
,,,#DEFINE  LCD_BusDatos   PORTD
,,,
,,,; Subrutina "LCD_Inicializa" ------------------------------------------------------------
,,,;
,,,; Inicialización del módulo LCD: Configura funciones del LCD, produce reset por software,
,,,; borra memoria y enciende pantalla. El fabricante especifica que para garantizar la
,,,; configuración inicial hay que hacerla como sigue:
,,,;
000005AE,,LCD_Inicializa,LCD_Inicializa
000005AE,1683,,        bsf     STATUS,RP0              ; Configura las líneas conectadas al pines RS,
000005AF,1088,,        bcf     LCD_PinRS               ; R/W y E.
000005B0,1188,,        bcf     LCD_PinEnable
000005B1,1108,,        bcf     LCD_PinRW
000005B2,0188,,        clrf    LCD_BusDatos
000005B3,1283,,        bcf     STATUS,RP0
,,,
000005B4,3017,,        MOVLW   0x17
000005B5,25F3,,        CALL    LCD_PosicionLinea1
000005B6,268D,,        CALL    LCD_Leer
000005B7,3C50,,        SUBLW   0x50
000005B8,39F0,,        ANDLW   0xF0
000005B9,1903,,        BTFSC   STATUS,Z
000005BA,0008,,        RETURN
,,,
000005BB,26D4,,        CALL    Retardo_50ms            ; Retardo inicial para que VDD llegue a 4.5v
,,,
,,,
000005BC,1108,,        bcf     LCD_PinRW               ; En caso de que esté conectado le indica
,,,                                        ; que se va a escribir en el LCD.
000005BD,1188,,        bcf     LCD_PinEnable           ; Impide funcionamiento del LCD poniendo E=0.
000005BE,1088,,        bcf     LCD_PinRS               ; Activa el Modo Comando poniendo RS=0.
,,,
000005BF,2652,,        CALL    LCD_EspBF               ; Espera que no este ocupado
000005C0,3020,,        movlw   b'00100000'
000005C1,25E3,,        call    LCD_EscribeLCD          ; Escribe el dato en el LCD.
000005C2,3020,,        movlw   b'00100000'
000005C3,25E3,,        call    LCD_EscribeLCD
000005C4,30C0,,        movlw   b'11000000'             ; Modo dos lineas
000005C5,25E3,,        call    LCD_EscribeLCD
,,,
000005C6,26C8,,        CALL    Retardo_50micros
,,,
000005C7,2652,,        CALL    LCD_EspBF               ; Display ON, cursor y blikc crusor apagado
000005C8,3000,,        movlw   b'00000000'             ;
000005C9,25E3,,        call    LCD_EscribeLCD
000005CA,30D0,,        movlw   b'11010000'             ;
000005CB,25E3,,        call    LCD_EscribeLCD
,,,
000005CC,26C8,,        CALL    Retardo_50micros
,,,
000005CD,2652,,        CALL    LCD_EspBF               ; Borra LCD
000005CE,3000,,        movlw   b'00000000'             ;
000005CF,25E3,,        call    LCD_EscribeLCD
000005D0,3010,,        movlw   b'00010000'
000005D1,25E3,,        call    LCD_EscribeLCD
,,,
000005D2,26DC,,        CALL    Retardo_2ms
,,,
000005D3,2652,,        CALL    LCD_EspBF               ; Modo incrementar con enteri shift off
000005D4,3000,,        movlw   b'00000000'             ;
000005D5,25E3,,        call    LCD_EscribeLCD
000005D6,3060,,        movlw   b'01100000'
000005D7,25E3,,        call    LCD_EscribeLCD
000005D8,26DC,,        CALL    Retardo_2ms
000005D9,2674,,        CALL    LCD_DIBLOGO
,,,
,,,
000005DA,2652,,        CALL    LCD_EspBF               ; Espera que no este ocupado
000005DB,25FB,,        CALL    LCD_CursorOFF
,,,
000005DC,26A9,,        CALL    LCD_Borra
000005DD,25EF,,        CALL    LCD_Linea1
,,,
000005DE,3017,,        MOVLW   0x17
000005DF,25F3,,        CALL    LCD_PosicionLinea1
000005E0,3055,,        MOVLW   0x55                            ; Manda la letra 'U'=0x55 a un lugar donde no se ve
000005E1,2608,,        CALL    LCD_Caracter
,,,
,,,
000005E2,0008,,        RETURN
,,,
,,,
,,,
,,,
,,,
,,,; Subrutina "LCD_EscribeLCD" -----------------------------------------------------------
,,,;
,,,; Envía el dato del registro de trabajo W al bus de dato y produce un pequeño pulso en el pin
,,,; Enable del LCD. Para no alterar el contenido de las líneas de la parte baja del Puerto B que
,,,; no son utilizadas para el LCD (pines RB3:RB0), primero se lee estas líneas y después se
,,,; vuelve a enviar este dato sin cambiarlo.
,,,
000005E3,,LCD_EscribeLCD,LCD_EscribeLCD
000005E3,39F0,,        andlw   b'11110000'             ; Se queda con el nibble alto del dato que es el
000005E4,00CC,,        movwf   LCD_Dato                ; que hay que enviar y lo guarda.
000005E5,0808,,        movf    LCD_BusDatos,W          ; Lee la información actual de la parte baja
000005E6,390F,,        andlw   b'00001111'             ; del Puerto B, que no se debe alterar.
000005E7,074C,,        addwf   LCD_Dato,W              ; Enviará la parte alta del dato de entrada
,,,                                        ; y en la parte baja lo que había antes.
,,,
000005E8,0088,,        movwf   LCD_BusDatos            ; Envía el dato al módulo LCD.
000005E9,1588,,        bsf     LCD_PinEnable           ; Permite funcionamiento del LCD mediante un pequeño
000005EA,26B9,,        CALL    Retardo_10micros
000005EB,1188,,        bcf     LCD_PinEnable           ; pulso y termina impidiendo el funcionamiento del LCD.
000005EC,0008,,        return
,,,
,,,; Subrutinas variadas para el control del módulo LCD -----------------------------------------
,,,;
,,,;Los comandos que pueden ser ejecutados son:
,,,;
000005ED,,LCD_CursorIncr,LCD_CursorIncr                          ; Cursor en modo incrementar.
000005ED,3006,,        movlw   b'00000110'
000005EE,2E03,,        goto    LCD_EnviaComando
000005EF,,LCD_Linea1,LCD_Linea1                              ; Cursor al principio de la Línea 1.
000005EF,3080,,        movlw   b'10000000'             ; Dirección 00h de la DDRAM
000005F0,2E03,,        goto    LCD_EnviaComando
000005F1,,LCD_Linea2,LCD_Linea2                              ; Cursor al principio de la Línea 2.
000005F1,30C0,,        movlw   b'11000000'             ; Dirección 40h de la DDRAM
000005F2,2E03,,        goto    LCD_EnviaComando
000005F3,,LCD_PosicionLinea1,LCD_PosicionLinea1                      ; Cursor a posición de la Línea 1, a partir de la
000005F3,3880,,        iorlw   b'10000000'             ; dirección 00h de la DDRAM más el valor del
000005F4,2E03,,        goto    LCD_EnviaComando        ; registro W.
000005F5,,LCD_PosicionLinea2,LCD_PosicionLinea2                      ; Cursor a posición de la Línea 2, a partir de la
000005F5,38C0,,        iorlw   b'11000000'             ; dirección 40h de la DDRAM más el valor del
000005F6,2E03,,        goto    LCD_EnviaComando        ; registro W.
000005F7,,LCD_OFF,LCD_OFF                         ; Pantalla apagada.
000005F7,3008,,        movlw   b'00001000'
000005F8,2E03,,        goto    LCD_EnviaComando
000005F9,,LCD_CursorON,LCD_CursorON                            ; Pantalla encendida y cursor encendido.
000005F9,300E,,        movlw   b'00001110'
000005FA,2E03,,        goto    LCD_EnviaComando
000005FB,,LCD_CursorOFF,LCD_CursorOFF                           ; Pantalla encendida y cursor apagado.
000005FB,300C,,        movlw   b'00001100'
000005FC,2E03,,        goto    LCD_EnviaComando
000005FD,,LCD_2Lineas4Bits5x7,LCD_2Lineas4Bits5x7                     ; Define la pantalla de 2 líneas, con caracteres
000005FD,3028,,        movlw   b'00101000'             ; de 5x7 puntos y conexión al PIC mediante bus de
,,,;       goto    LCD_EnviaComando        ; 4 bits.
,,,
,,,; Subrutinas "LCD_EnviaComando" y "LCD_Caracter" ------------------------------------
,,,;
,,,; "LCD_EnviaComando". Escribe un comando en el registro del módulo LCD. La palabra de
,,,; comando ha sido entregada a través del registro W.  Trabaja en Modo Comando.
,,,; "LCD_Caracter". Escribe en la memoria DDRAM del LCD el carácter ASCII introducido a
,,,; a través del registro W. Trabaja en Modo Dato.
,,,;
,,,
000005FE,,LCD_EnviaDato,LCD_EnviaDato
000005FE,00CD,,        movwf   LCD_GuardaDato          ; Guarda el dato a enviar.
000005FF,2652,,        CALL    LCD_EspBF
00000600,084D,,        MOVF    LCD_GuardaDato,W
00000601,1488,,        bsf     LCD_PinRS               ; Activa el Modo Comando, poniendo RS=0.
00000602,2E0D,,        goto    LCD_Envia
00000603,,LCD_EnviaComando,LCD_EnviaComando
00000603,00CD,,        movwf   LCD_GuardaDato          ; Guarda el dato a enviar.
00000604,2652,,        CALL    LCD_EspBF
00000605,084D,,        MOVF    LCD_GuardaDato,W
00000606,1088,,        bcf     LCD_PinRS               ; Activa el Modo Comando, poniendo RS=0.
00000607,2E0D,,        goto    LCD_Envia
00000608,,LCD_Caracter,LCD_Caracter
00000608,00CD,,        movwf   LCD_GuardaDato          ; Guarda el dato a enviar.
00000609,2652,,        CALL    LCD_EspBF
0000060A,084D,,        MOVF    LCD_GuardaDato,W
0000060B,1488,,        bsf     LCD_PinRS               ; Activa el "Modo Dato", poniendo RS=1.
0000060C,2616,,        call    LCD_CodigoCGROM         ; Obtiene el código para correcta visualización.
0000060D,,LCD_Envia,LCD_Envia
0000060D,00CD,,        movwf   LCD_GuardaDato          ; Guarda el dato a enviar.
0000060E,25E3,,        call    LCD_EscribeLCD          ; Primero envía el nibble alto.
0000060F,0E4D,,        swapf   LCD_GuardaDato,W        ; Ahora envía el nibble bajo. Para ello pasa el
,,,                                        ; nibble bajo del dato a enviar a parte alta del byte.
00000610,25E3,,        call    LCD_EscribeLCD          ; Se envía al visualizador LCD.
00000611,1C88,,        btfss   LCD_PinRS               ; Debe garantizar una correcta escritura manteniendo
00000612,26DC,,        call    Retardo_2ms             ; 2 ms en modo comando y 50 µs en modo cáracter.
00000613,26C8,,        call    Retardo_50micros
00000614,0850,,        MOVF    LCD_TEMP,W
00000615,0008,,        return
,,,
,,,; Subrutina "LCD_CodigoCGROM" -----------------------------------------------------------
,,,;
,,,; A partir del carácter ASCII número 127 los códigos de los caracteres definidos en la
,,,; tabla CGROM del LM016L no coinciden con los códigos ASCII. Así por ejemplo, el código
,,,; ASCII de la "Ñ" en la tabla CGRAM del LM016L es EEh.
,,,;
,,,; Esta subrutina convierte los códigos ASCII de la "Ñ", "º" y otros, a códigos CGROM para que
,,,; que puedan ser visualizado en el módulo LM016L.
,,,;
,,,; Entrada:      En (W) el código ASCII del carácter que se desea visualizar.
,,,; Salida:       En (W) el código definido en la tabla CGROM.
,,,
00000616,,LCD_CodigoCGROM,LCD_CodigoCGROM
00000616,00CC,,        movwf   LCD_Dato                ; Guarda el valor del carácter y comprueba si es
00000617,,LCD_EnheMinuscula,LCD_EnheMinuscula                       ; un carácter especial.
00000617,3CF1,,        sublw   'ñ'                     ; ¿Es la "ñ"?
00000618,1D03,,        btfss   STATUS,Z
00000619,2E1D,,        goto    LCD_EnheMayuscula       ; No es "ñ".
0000061A,30EE,,        movlw   b'11101110'             ; Código CGROM de la "ñ".
0000061B,00CC,,        movwf   LCD_Dato
0000061C,2E2A,,        goto    LCD_FinCGROM
0000061D,,LCD_EnheMayuscula,LCD_EnheMayuscula
0000061D,084C,,        movf    LCD_Dato,W              ; Recupera el código ASCII de entrada.
0000061E,3CD1,,        sublw   'Ñ'                     ; ¿Es la "Ñ"?
0000061F,1D03,,        btfss   STATUS,Z
00000620,2E24,,        goto    LCD_Grado               ; No es "Ñ".
00000621,30EE,,        movlw   b'11101110'             ; Código CGROM de la "ñ". (No hay símbolo para
00000622,00CC,,        movwf   LCD_Dato                ; la "Ñ" mayúscula en la CGROM).
00000623,2E2A,,        goto    LCD_FinCGROM
00000624,,LCD_Grado,LCD_Grado
00000624,084C,,        movf    LCD_Dato,W              ; Recupera el código ASCII de entrada.
00000625,3CBA,,        sublw   'º'                     ; ¿Es el símbolo "º"?
00000626,1D03,,        btfss   STATUS,Z
00000627,2E2A,,        goto    LCD_FinCGROM            ; No es "º".
00000628,30DF,,        movlw   b'11011111'             ; Código CGROM del símbolo "º".
00000629,00CC,,        movwf   LCD_Dato
0000062A,,LCD_FinCGROM,LCD_FinCGROM
0000062A,084C,,        movf    LCD_Dato,W              ; En (W) el código buscado.
0000062B,0008,,        return
,,,
,,,; Subrutina "LCD_DosEspaciosBlancos" y "LCD_LineaBlanco" --------------------------------
,,,;
,,,; Visualiza espacios en blanco.
,,,
0000062C,,LCD_LineaEnBlanco,LCD_LineaEnBlanco
0000062C,3010,,        movlw   LCD_CaracteresPorLinea
0000062D,2E33,,        goto    LCD_EnviaBlancos
0000062E,,LCD_UnEspacioBlanco,LCD_UnEspacioBlanco
0000062E,3001,,        movlw   .1
0000062F,2E33,,        goto    LCD_EnviaBlancos
00000630,,LCD_DosEspaciosBlancos,LCD_DosEspaciosBlancos
00000630,3002,,        movlw   .2
00000631,2E33,,        goto    LCD_EnviaBlancos
00000632,,LCD_TresEspaciosBlancos,LCD_TresEspaciosBlancos
00000632,3003,,        movlw   .3
00000633,,LCD_EnviaBlancos,LCD_EnviaBlancos
00000633,00CE,,        movwf   LCD_Auxiliar1           ; (LCD_Auxiliar1) se utiliza como contador.
00000634,,LCD_EnviaOtroBlanco,LCD_EnviaOtroBlanco
00000634,3020,,        movlw   ' '                     ; Esto es un espacio en blanco.
00000635,2608,,        call    LCD_Caracter            ; Visualiza tanto espacios en blanco como se
00000636,0BCE,,        decfsz  LCD_Auxiliar1,F         ; haya cargado en (LCD_Auxiliar1).
00000637,2E34,,        goto    LCD_EnviaOtroBlanco
00000638,0008,,        return
,,,
,,,; Subrutinas "LCD_ByteCompleto" y "LCD_Byte" --------------------------------------------
,,,;
,,,; Subrutina "LCD_ByteCompleto", visualiza el byte que almacena el registro W en el
,,,; lugar actual de la pantalla. Por ejemplo, si (W)=b'10101110' visualiza "AE".
,,,;
,,,; Subrutina "LCD_Byte" igual que la anterior, pero en caso de que el nibble alto sea cero
,,,; visualiza en su lugar un espacio en blanco. Por ejemplo si (W)=b'10101110' visualiza "AE"
,,,; y si (W)=b'00001110', visualiza " E" (un espacio blanco delante).
,,,;
,,,; Utilizan la subrutina "LCD_Nibble" que se analiza más adelante.
,,,;
00000639,,LCD_Byte,LCD_Byte
00000639,00D0,,        MOVWF   LCD_TEMP
0000063A,00CF,,        movwf   LCD_Auxiliar2           ; Guarda el valor de entrada.
0000063B,39F0,,        andlw   b'11110000'             ; Analiza si el nibble alto es cero.
0000063C,1D03,,        btfss   STATUS,Z                ; Si es cero lo apaga.
0000063D,2E43,,        goto    LCD_VisualizaAlto               ; No es cero y lo visualiza.
0000063E,3020,,        movlw   ' '                     ; Visualiza un espacio en blanco.
0000063F,2608,,        call    LCD_Caracter
00000640,2E45,,        goto    LCD_VisualizaBajo
,,,
00000641,,LCD_ByteCompleto,LCD_ByteCompleto
00000641,00D0,,        MOVWF   LCD_TEMP
00000642,00CF,,        movwf   LCD_Auxiliar2           ; Guarda el valor de entrada.
00000643,,LCD_VisualizaAlto,LCD_VisualizaAlto
00000643,0E4F,,        swapf   LCD_Auxiliar2,W         ; Pone el nibble alto en la parte baja.
00000644,2646,,        call    LCD_Nibble              ; Lo visualiza.
00000645,,LCD_VisualizaBajo,LCD_VisualizaBajo
00000645,084F,,        movf    LCD_Auxiliar2,W         ; Repite el proceso con el nibble bajo.
,,,;       call    LCD_Nibble              ; Lo visualiza.
,,,;       return
,,,
,,,; Subrutina "LCD_Nibble" ----------------------------------------------------------------
,,,;
,,,; Visualiza en el lugar actual de la pantalla, el valor hexadecimal que almacena en el nibble
,,,; bajo del registro W. El nibble alto de W no es tenido en cuenta. Ejemplos:
,,,; - Si (W)=b'01010110', se visualizará "6".
,,,; - Si (W)=b'10101110', se visualizará "E".
,,,;
00000646,,LCD_Nibble,LCD_Nibble
00000646,00D0,,        MOVWF   LCD_TEMP
00000647,390F,,        andlw   b'00001111'             ; Se queda con la parte baja.
00000648,00CE,,        movwf   LCD_Auxiliar1           ; Lo guarda.
00000649,3C09,,        sublw   0x09                    ; Comprueba si hay que representarlo con letra.
0000064A,1C03,,        btfss   STATUS,C
0000064B,2E4F,,        goto    LCD_EnviaByteLetra
0000064C,084E,,        movf    LCD_Auxiliar1,W
0000064D,3E30,,        addlw   '0'                     ; El número se pasa a carácter ASCII sumándole
0000064E,2E51,,        goto    LCD_FinVisualizaDigito  ; el ASCII del cero y lo visualiza.
0000064F,,LCD_EnviaByteLetra,LCD_EnviaByteLetra
0000064F,084E,,        movf    LCD_Auxiliar1,W
00000650,3E37,,        addlw   'A'-0x0A                        ; Sí, por tanto, se le suma el ASCII de la 'A'.
00000651,,LCD_FinVisualizaDigito,LCD_FinVisualizaDigito
00000651,2E08,,        goto    LCD_Caracter            ; Y visualiza el carácter. Se hace con un "goto"
,,,                                        ; para no sobrecargar la pila.
,,,
00000652,,LCD_EspBF,LCD_EspBF
00000652,1051,,        BCF     LCD_TEMPRS,0            ; Guarda RS
00000653,1888,,        BTFSC   LCD_PinRS
00000654,1451,,        BSF     LCD_TEMPRS,0
00000655,1188,,        BCF     LCD_PinEnable
00000656,1088,,        BCF     LCD_PinRS
00000657,1508,,        BSF     LCD_PinRW               ; Modo lectura
,,,
00000658,1683,,        BSF     STATUS,RP0              ; Pone a 1 el bit 5 del STATUS. Acceso al Banco 1.
00000659,1608,,        BSF     PORTD,4                 ; Coloca a los pines de datos como entrada
0000065A,1688,,        BSF     PORTD,5
0000065B,1708,,        BSF     PORTD,6
0000065C,1788,,        BSF     PORTD,7
0000065D,1283,,        BCF     STATUS,RP0              ; Pone a 1 el bit 5 del STATUS. Acceso al Banco 1.
,,,
0000065E,26B9,,        CALL    Retardo_10micros
,,,
0000065F,,LCD_EspBF2,LCD_EspBF2
0000065F,1588,,        BSF     LCD_PinEnable
00000660,26B9,,        CALL    Retardo_10micros
00000661,1188,,        BCF     LCD_PinEnable
00000662,26B9,,        CALL    Retardo_10micros
00000663,1588,,        BSF     LCD_PinEnable
00000664,1B88,,        BTFSC   PORTD,7                 ; Si D7 esta en alto esta ocupado
00000665,2E5F,,        GOTO    LCD_EspBF2              ; Si este en cero esta libre y salta
,,,
00000666,1188,,        BCF     LCD_PinEnable
00000667,1108,,        BCF     LCD_PinRW
00000668,26B9,,        CALL    Retardo_10micros
,,,
00000669,1683,,        BSF     STATUS,RP0              ; Pone a 1 el bit 5 del STATUS. Acceso al Banco 1.
0000066A,1208,,        BCF     PORTD,4                 ; Coloca al puerto de datos como salida
0000066B,1288,,        BCF     PORTD,5
0000066C,1308,,        BCF     PORTD,6
0000066D,1388,,        BCF     PORTD,7
0000066E,1283,,        BCF     STATUS,RP0              ; Pone a 1 el bit 5 del STATUS. Acceso al Banco 1.
,,,
0000066F,26B9,,        CALL    Retardo_10micros
,,,
00000670,1088,,        BCF     LCD_PinRS               ; Devuelve RS
00000671,1851,,        BTFSC   LCD_TEMPRS,0
00000672,1488,,        BSF     LCD_PinRS
,,,
00000673,0008,,        RETURN
,,,
,,,
00000674,,LCD_DIBLOGO,LCD_DIBLOGO
00000674,2652,,        CALL    LCD_EspBF               ; Accede a CGRAM
00000675,3040,,        movlw   b'01000000'             ;
00000676,25E3,,        call    LCD_EscribeLCD
00000677,3000,,        movlw   b'00000000'
00000678,25E3,,        call    LCD_EscribeLCD
00000679,26DC,,        CALL    Retardo_2ms
0000067A,01B8,,        CLRF    CONTLEDLCD
,,,
0000067B,,LCD_DIBLOGO1,LCD_DIBLOGO1
0000067B,300E,,        MOVLW   0x0E                            ; Posición de la pagina de la tabla
0000067C,008A,,        MOVWF   PCLATH
0000067D,0838,,        MOVF    CONTLEDLCD,W
0000067E,2601,,        CALL    LCD_DIBLOGORET
0000067F,018A,,        CLRF    PCLATH
00000680,25FE,,        CALL    LCD_EnviaDato
00000681,0AB8,,        INCF    CONTLEDLCD,F
00000682,3030,,        MOVLW   d'48'
00000683,0238,,        SUBWF   CONTLEDLCD,W
00000684,1D03,,        BTFSS   STATUS,Z
00000685,2E7B,,        GOTO    LCD_DIBLOGO1
,,,
00000686,1088,,        bcf     LCD_PinRS               ; Activa el Modo Comando poniendo RS=0.
00000687,2652,,        CALL    LCD_EspBF               ; Espera que no este ocupado
00000688,3080,,        movlw   b'10000000'
00000689,25E3,,        call    LCD_EscribeLCD          ; Escribe el dato en el LCD.
0000068A,3000,,        movlw   b'00000000'
0000068B,25E3,,        call    LCD_EscribeLCD
0000068C,0008,,        RETURN
,,,
0000068D,,LCD_Leer,LCD_Leer
,,,
0000068D,1188,,        BCF     LCD_PinEnable
0000068E,1488,,        BSF     LCD_PinRS
0000068F,1508,,        BSF     LCD_PinRW               ; Modo lectura en la RAM
,,,
00000690,1683,,        BSF     STATUS,RP0              ; Pone a 1 el bit 5 del STATUS. Acceso al Banco 1.
00000691,1608,,        BSF     PORTD,4                 ; Coloca a los pines de datos como entrada
00000692,1688,,        BSF     PORTD,5
00000693,1708,,        BSF     PORTD,6
00000694,1788,,        BSF     PORTD,7
00000695,1283,,        BCF     STATUS,RP0              ; Pone a 1 el bit 5 del STATUS. Acceso al Banco 1.
00000696,26B9,,        CALL    Retardo_10micros
,,,
00000697,1588,,        BSF     LCD_PinEnable
00000698,26B9,,        CALL    Retardo_10micros
00000699,0808,,        MOVF    LCD_BusDatos,W
0000069A,00CC,,        MOVWF   LCD_Dato
0000069B,1188,,        BCF     LCD_PinEnable
0000069C,1108,,        BCF     LCD_PinRW
0000069D,26B9,,        CALL    Retardo_10micros
,,,
0000069E,1683,,        BSF     STATUS,RP0              ; Pone a 1 el bit 5 del STATUS. Acceso al Banco 1.
0000069F,1208,,        BCF     PORTD,4                 ; Coloca al puerto de datos como salida
000006A0,1288,,        BCF     PORTD,5
000006A1,1308,,        BCF     PORTD,6
000006A2,1388,,        BCF     PORTD,7
000006A3,1283,,        BCF     STATUS,RP0              ; Pone a 1 el bit 5 del STATUS. Acceso al Banco 1.
,,,
000006A4,26B9,,        CALL    Retardo_10micros
,,,
000006A5,1088,,        BCF     LCD_PinRS               ; Devuelve RS
000006A6,084C,,        MOVF    LCD_Dato,W
000006A7,39F0,,        ANDLW   b'11110000'
000006A8,0008,,        RETURN
,,,
,,,
,,,
000006A9,,LCD_Borra,LCD_Borra                               ; Borra toda la pantalla, memoria DDRAM y pone el
000006A9,3001,,        movlw   b'00000001'             ; cursor a principio de la línea 1.
000006AA,00CD,,        movwf   LCD_GuardaDato          ; Guarda el dato a enviar.
000006AB,2652,,        CALL    LCD_EspBF
000006AC,1088,,        bcf     LCD_PinRS               ; Activa el Modo Comando, poniendo RS=0.
,,,
000006AD,00CD,,        movwf   LCD_GuardaDato          ; Guarda el dato a enviar.
000006AE,25E3,,        call    LCD_EscribeLCD          ; Primero envía el nibble alto.
000006AF,0E4D,,        swapf   LCD_GuardaDato,W        ; Ahora envía el nibble bajo. Para ello pasa el
,,,                                        ; nibble bajo del dato a enviar a parte alta del byte.
000006B0,25E3,,        call    LCD_EscribeLCD          ; Se envía al visualizador LCD.
000006B1,26DC,,        call    Retardo_2ms             ; 2 ms en modo comando y 50 µs en modo cáracter.
000006B2,0850,,        MOVF    LCD_TEMP,W
,,,
000006B3,3017,,        MOVLW   0x17
000006B4,25F3,,        CALL    LCD_PosicionLinea1
000006B5,3055,,        MOVLW   0x55                            ; Manda la letra 'U'=0x55 a un lugar donde no se ve
000006B6,2608,,        CALL    LCD_Caracter
000006B7,25EF,,        CALL    LCD_Linea1
000006B8,0008,,        return
,,,        INCLUDE "D:\Electronica\RelojMA\Librerias\RETARDOS.INC"
,,,;**************************** Librería "RETARDOS.INC" *********************************
,,,;
,,,;       ===================================================================
,,,;         Del libro "MICROCONTROLADOR PIC16F84. DESARROLLO DE PROYECTOS"
,,,;         E. Palacios, F. Remiro y L. López.
,,,;         Editorial Ra-Ma.  www.ra-ma.es
,,,;       ===================================================================
,,,;
,,,; Librería con múltiples subrutinas de retardos, desde 4 microsegundos hasta 20 segundos.
,,,; Además se pueden implementar otras subrutinas muy fácilmente.
,,,;
,,,; Se han calculado para un sistema microcontrolador con un PIC trabajando con un cristal
,,,; de cuarzo a 4 MHz. Como cada ciclo máquina son 4 ciclos de reloj, resulta que cada
,,,; ciclo máquina tarda 4 x 1/4MHz = 1 µs.
,,,;
,,,; En los comentarios, "cm" significa "ciclos máquina".
,,,;
,,,; ZONA DE DATOS *********************************************************************
,,,
,,,        CBLOCK
,,,        R_ContA                         ; Contadores para los retardos.
,,,        R_ContB
,,,        R_ContC
,,,        R_ContSeg
,,,        ENDC
,,,;
,,,; RETARDOS de 4 hasta 10 microsegundos ---------------------------------------------------
,,,;
,,,; A continuación retardos pequeños teniendo en cuenta que para una frecuencia de 4 MHZ,
,,,; la llamada a subrutina "call" tarda 2 ciclos máquina, el retorno de subrutina
,,,; "return" toma otros 2 ciclos máquina y cada instrucción "nop" tarda 1 ciclo máquina.
,,,;
000006B9,,Retardo_10micros,Retardo_10micros                                ; La llamada "call" aporta 2 ciclos máquina.
000006B9,0000,,        nop                             ; Aporta 1 ciclo máquina.
000006BA,0000,,        nop                             ; Aporta 1 ciclo máquina.
000006BB,0000,,        nop                             ; Aporta 1 ciclo máquina.
000006BC,0000,,        nop                             ; Aporta 1 ciclo máquina.
000006BD,0000,,        nop                             ; Aporta 1 ciclo máquina.
000006BE,,Retardo_5micros,Retardo_5micros                         ; La llamada "call" aporta 2 ciclos máquina.
000006BE,0000,,        nop                             ; Aporta 1 ciclo máquina.
000006BF,,Retardo_4micros,Retardo_4micros                         ; La llamada "call" aporta 2 ciclos máquina.
000006BF,0008,,        return                          ; El salto del retorno aporta 2 ciclos máquina.
,,,;
,,,; RETARDOS de 20 hasta 500 microsegundos ------------------------------------------------
,,,;
000006C0,,Retardo_500micros,Retardo_500micros                               ; La llamada "call" aporta 2 ciclos máquina.
000006C0,0000,,        nop                             ; Aporta 1 ciclo máquina.
000006C1,30A4,,        movlw   d'164'                  ; Aporta 1 ciclo máquina. Este es el valor de "K".
000006C2,2ECC,,        goto    RetardoMicros           ; Aporta 2 ciclos máquina.
000006C3,,Retardo_200micros,Retardo_200micros                               ; La llamada "call" aporta 2 ciclos máquina.
000006C3,0000,,        nop                             ; Aporta 1 ciclo máquina.
000006C4,3040,,        movlw   d'64'                   ; Aporta 1 ciclo máquina. Este es el valor de "K".
000006C5,2ECC,,        goto    RetardoMicros           ; Aporta 2 ciclos máquina.
000006C6,,Retardo_100micros,Retardo_100micros                               ; La llamada "call" aporta 2 ciclos máquina.
000006C6,301F,,        movlw   d'31'                   ; Aporta 1 ciclo máquina. Este es el valor de "K".
000006C7,2ECC,,        goto    RetardoMicros           ; Aporta 2 ciclos máquina.
000006C8,,Retardo_50micros,Retardo_50micros                                ; La llamada "call" aporta 2 ciclos máquina.
000006C8,0000,,        nop                             ; Aporta 1 ciclo máquina.
000006C9,300E,,        movlw   d'14'                   ; Aporta 1 ciclo máquina. Este es el valor de "K".
000006CA,2ECC,,        goto    RetardoMicros           ; Aporta 2 ciclos máquina.
000006CB,,Retardo_20micros,Retardo_20micros                                ; La llamada "call" aporta 2 ciclos máquina.
000006CB,3005,,        movlw   d'5'                    ; Aporta 1 ciclo máquina. Este es el valor de "K".
,,,;
,,,; El próximo bloque "RetardoMicros" tarda:
,,,; 1 + (K-1) + 2 + (K-1)x2 + 2 = (2 + 3K) ciclos máquina.
,,,;
000006CC,,RetardoMicros,RetardoMicros
000006CC,00D2,,        movwf   R_ContA                 ; Aporta 1 ciclo máquina.
000006CD,,Rmicros_Bucle,Rmicros_Bucle
000006CD,0BD2,,        decfsz  R_ContA,F               ; (K-1)x1 cm (cuando no salta) + 2 cm (al saltar).
000006CE,2ECD,,        goto    Rmicros_Bucle           ; Aporta (K-1)x2 ciclos máquina.
000006CF,0008,,        return                          ; El salto del retorno aporta 2 ciclos máquina.
,,,;
,,,;En total estas subrutinas tardan:
,,,; - Retardo_500micros:  2 + 1 + 1 + 2 + (2 + 3K) = 500 cm = 500 µs. (para K=164 y 4 MHz).
,,,; - Retardo_200micros:  2 + 1 + 1 + 2 + (2 + 3K) = 200 cm = 200 µs. (para K= 64 y 4 MHz).
,,,; - Retardo_100micros:  2     + 1 + 2 + (2 + 3K) = 100 cm = 100 µs. (para K= 31 y 4 MHz).
,,,; - Retardo_50micros :  2 + 1 + 1 + 2 + (2 + 3K) =  50 cm =  50 µs. (para K= 14 y 4 MHz).
,,,; - Retardo_20micros :  2     + 1     + (2 + 3K) =  20 cm =  20 µs. (para K=  5 y 4 MHz).
,,,;
,,,; RETARDOS de 1 ms hasta 200 ms. --------------------------------------------------------
,,,;
000006D0,,Retardo_200ms,Retardo_200ms                           ; La llamada "call" aporta 2 ciclos máquina.
000006D0,30C8,,        movlw   d'200'                  ; Aporta 1 ciclo máquina. Este es el valor de "M".
000006D1,2EDF,,        goto    Retardos_ms             ; Aporta 2 ciclos máquina.
000006D2,,Retardo_100ms,Retardo_100ms                           ; La llamada "call" aporta 2 ciclos máquina.
000006D2,3064,,        movlw   d'100'                  ; Aporta 1 ciclo máquina. Este es el valor de "M".
000006D3,2EDF,,        goto    Retardos_ms             ; Aporta 2 ciclos máquina.
000006D4,,Retardo_50ms,Retardo_50ms                            ; La llamada "call" aporta 2 ciclos máquina.
000006D4,3032,,        movlw   d'50'                   ; Aporta 1 ciclo máquina. Este es el valor de "M".
000006D5,2EDF,,        goto    Retardos_ms             ; Aporta 2 ciclos máquina.
000006D6,,Retardo_20ms,Retardo_20ms                            ; La llamada "call" aporta 2 ciclos máquina.
000006D6,3014,,        movlw   d'20'                   ; Aporta 1 ciclo máquina. Este es el valor de "M".
000006D7,2EDF,,        goto    Retardos_ms             ; Aporta 2 ciclos máquina.
000006D8,,Retardo_10ms,Retardo_10ms                            ; La llamada "call" aporta 2 ciclos máquina.
000006D8,300A,,        movlw   d'10'                   ; Aporta 1 ciclo máquina. Este es el valor de "M".
000006D9,2EDF,,        goto    Retardos_ms             ; Aporta 2 ciclos máquina.
000006DA,,Retardo_5ms,Retardo_5ms                             ; La llamada "call" aporta 2 ciclos máquina.
000006DA,3005,,        movlw   d'5'                    ; Aporta 1 ciclo máquina. Este es el valor de "M".
000006DB,2EDF,,        goto    Retardos_ms             ; Aporta 2 ciclos máquina.
000006DC,,Retardo_2ms,Retardo_2ms                             ; La llamada "call" aporta 2 ciclos máquina.
000006DC,3002,,        movlw   d'2'                    ; Aporta 1 ciclo máquina. Este es el valor de "M".
000006DD,2EDF,,        goto    Retardos_ms             ; Aporta 2 ciclos máquina.
000006DE,,Retardo_1ms,Retardo_1ms                             ; La llamada "call" aporta 2 ciclos máquina.
000006DE,3001,,        movlw   d'1'                    ; Aporta 1 ciclo máquina. Este es el valor de "M".
,,,;
,,,; El próximo bloque "Retardos_ms" tarda:
,,,; 1 + M + M + KxM + (K-1)xM + Mx2 + (K-1)Mx2 + (M-1) + 2 + (M-1)x2 + 2 =
,,,; = (2 + 4M + 4KM) ciclos máquina. Para K=249 y M=1 supone 1002 ciclos máquina
,,,; que a 4 MHz son 1002 µs = 1 ms.
,,,;
000006DF,,Retardos_ms,Retardos_ms
000006DF,00D3,,        movwf   R_ContB                 ; Aporta 1 ciclo máquina.
000006E0,,R1ms_BucleExterno,R1ms_BucleExterno
000006E0,30F9,,        movlw   d'249'                  ; Aporta Mx1 ciclos máquina. Este es el valor de "K".
000006E1,00D2,,        movwf   R_ContA                 ; Aporta Mx1 ciclos máquina.
000006E2,,R1ms_BucleInterno,R1ms_BucleInterno
000006E2,0000,,        nop                             ; Aporta KxMx1 ciclos máquina.
000006E3,0BD2,,        decfsz  R_ContA,F               ; (K-1)xMx1 cm (cuando no salta) + Mx2 cm (al saltar).
000006E4,2EE2,,        goto    R1ms_BucleInterno               ; Aporta (K-1)xMx2 ciclos máquina.
000006E5,0BD3,,        decfsz  R_ContB,F               ; (M-1)x1 cm (cuando no salta) + 2 cm (al saltar).
000006E6,2EE0,,        goto    R1ms_BucleExterno       ; Aporta (M-1)x2 ciclos máquina.
000006E7,0008,,        return                          ; El salto del retorno aporta 2 ciclos máquina.
,,,;
,,,;En total estas subrutinas tardan:
,,,; - Retardo_200ms:      2 + 1 + 2 + (2 + 4M + 4KM) = 200007 cm = 200 ms. (M=200 y K=249).
,,,; - Retardo_100ms:      2 + 1 + 2 + (2 + 4M + 4KM) = 100007 cm = 100 ms. (M=100 y K=249).
,,,; - Retardo_50ms :      2 + 1 + 2 + (2 + 4M + 4KM) =  50007 cm =  50 ms. (M= 50 y K=249).
,,,; - Retardo_20ms :      2 + 1 + 2 + (2 + 4M + 4KM) =  20007 cm =  20 ms. (M= 20 y K=249).
,,,; - Retardo_10ms :      2 + 1 + 2 + (2 + 4M + 4KM) =  10007 cm =  10 ms. (M= 10 y K=249).
,,,; - Retardo_5ms  :      2 + 1 + 2 + (2 + 4M + 4KM) =   5007 cm =   5 ms. (M=  5 y K=249).
,,,; - Retardo_2ms  :      2 + 1 + 2 + (2 + 4M + 4KM) =   2007 cm =   2 ms. (M=  2 y K=249).
,,,; - Retardo_1ms  :      2 + 1     + (2 + 4M + 4KM) =   1005 cm =   1 ms. (M=  1 y K=249).
,,,;
,,,; RETARDOS de 0.5 hasta 20 segundos ---------------------------------------------------
,,,;
000006E8,,Retardo_20s,Retardo_20s                             ; La llamada "call" aporta 2 ciclos máquina.
000006E8,30C8,,        movlw   d'200'                  ; Aporta 1 ciclo máquina. Este es el valor de "N".
000006E9,2EF3,,        goto    Retardo_1Decima         ; Aporta 2 ciclos máquina.
000006EA,,Retardo_10s,Retardo_10s                             ; La llamada "call" aporta 2 ciclos máquina.
000006EA,3064,,        movlw   d'100'                  ; Aporta 1 ciclo máquina. Este es el valor de "N".
000006EB,2EF3,,        goto    Retardo_1Decima         ; Aporta 2 ciclos máquina.
000006EC,,Retardo_5s,Retardo_5s                              ; La llamada "call" aporta 2 ciclos máquina.
000006EC,3032,,        movlw   d'50'                   ; Aporta 1 ciclo máquina. Este es el valor de "N".
000006ED,2EF3,,        goto    Retardo_1Decima         ; Aporta 2 ciclos máquina.
000006EE,,Retardo_2s,Retardo_2s                              ; La llamada "call" aporta 2 ciclos máquina.
000006EE,3014,,        movlw   d'20'                   ; Aporta 1 ciclo máquina. Este es el valor de "N".
000006EF,2EF3,,        goto    Retardo_1Decima         ; Aporta 2 ciclos máquina.
000006F0,,Retardo_1s,Retardo_1s                              ; La llamada "call" aporta 2 ciclos máquina.
000006F0,300A,,        movlw   d'10'                   ; Aporta 1 ciclo máquina. Este es el valor de "N".
000006F1,2EF3,,        goto    Retardo_1Decima         ; Aporta 2 ciclos máquina.
000006F2,,Retardo_500ms,Retardo_500ms                           ; La llamada "call" aporta 2 ciclos máquina.
000006F2,3005,,        movlw   d'5'                    ; Aporta 1 ciclo máquina. Este es el valor de "N".
,,,;
,,,; El próximo bloque "Retardo_1Decima" tarda:
,,,; 1 + N + N + MxN + MxN + KxMxN + (K-1)xMxN + MxNx2 + (K-1)xMxNx2 +
,,,;   + (M-1)xN + Nx2 + (M-1)xNx2 + (N-1) + 2 + (N-1)x2 + 2 =
,,,; = (2 + 4M + 4MN + 4KM) ciclos máquina. Para K=249, M=100 y N=1 supone 100011
,,,; ciclos máquina que a 4 MHz son 100011 µs = 100 ms = 0,1 s = 1 décima de segundo.
,,,;
000006F3,,Retardo_1Decima,Retardo_1Decima
000006F3,0064,,        CLRWDT                          ; Resetea el WDT
000006F4,00D4,,        movwf   R_ContC                 ; Aporta 1 ciclo máquina.
000006F5,,R1Decima_BucleExterno2,R1Decima_BucleExterno2
000006F5,3064,,        movlw   d'100'                  ; Aporta Nx1 ciclos máquina. Este es el valor de "M".
000006F6,00D3,,        movwf   R_ContB                 ; Aporta Nx1 ciclos máquina.
000006F7,,R1Decima_BucleExterno,R1Decima_BucleExterno
000006F7,30F9,,        movlw   d'249'                  ; Aporta MxNx1 ciclos máquina. Este es el valor de "K".
000006F8,00D2,,        movwf   R_ContA                 ; Aporta MxNx1 ciclos máquina.
000006F9,,R1Decima_BucleInterno,R1Decima_BucleInterno
000006F9,0000,,        nop                             ; Aporta KxMxNx1 ciclos máquina.
000006FA,0BD2,,        decfsz  R_ContA,F               ; (K-1)xMxNx1 cm (si no salta) + MxNx2 cm (al saltar).
000006FB,2EF9,,        goto    R1Decima_BucleInterno   ; Aporta (K-1)xMxNx2 ciclos máquina.
000006FC,0BD3,,        decfsz  R_ContB,F               ; (M-1)xNx1 cm (cuando no salta) + Nx2 cm (al saltar).
000006FD,2EF7,,        goto    R1Decima_BucleExterno   ; Aporta (M-1)xNx2 ciclos máquina.
000006FE,0BD4,,        decfsz  R_ContC,F               ; (N-1)x1 cm (cuando no salta) + 2 cm (al saltar).
000006FF,2EF5,,        goto    R1Decima_BucleExterno2  ; Aporta (N-1)x2 ciclos máquina.
00000700,0008,,        return                          ; El salto del retorno aporta 2 ciclos máquina.
,,,;
,,,;En total estas subrutinas tardan:
,,,; - Retardo_20s:        2 + 1 + 2 + (2 + 4N + 4MN + 4KMN) = 20000807 cm = 20 s.
,,,;                       (N=200, M=100 y K=249).
,,,; - Retardo_10s:        2 + 1 + 2 + (2 + 4N + 4MN + 4KMN) = 10000407 cm = 10 s.
,,,;                       (N=100, M=100 y K=249).
,,,; - Retardo_5s:         2 + 1 + 2 + (2 + 4N + 4MN + 4KMN) =  5000207 cm =  5 s.
,,,;                       (N= 50, M=100 y K=249).
,,,; - Retardo_2s:         2 + 1 + 2 + (2 + 4N + 4MN + 4KMN) =  2000087 cm =  2 s.
,,,;                       (N= 20, M=100 y K=249).
,,,; - Retardo_1s:         2 + 1 + 2 + (2 + 4N + 4MN + 4KMN) =  1000047 cm =  1 s.
,,,;                       (N= 10, M=100 y K=249).
,,,; - Retardo_500ms:      2 + 1     + (2 + 4N + 4MN + 4KMN) =   500025 cm = 0,5 s.
,,,;                       (N=  5, M=100 y K=249).
,,,
,,,;       ===================================================================
,,,;         Del libro "MICROCONTROLADOR PIC16F84. DESARROLLO DE PROYECTOS"
,,,;         E. Palacios, F. Remiro y L. López.
,,,;         Editorial Ra-Ma.  www.ra-ma.es
,,,;       ===================================================================
,,,
,,,
,,,
00000701,,Retardo_wseg,Retardo_wseg
00000701,390F,,        ANDLW           b'00001111'
00000702,00D5,,        MOVWF           R_ContSeg
00000703,0AD5,,        INCF            R_ContSeg,F
00000704,,Retardo_wseg1,Retardo_wseg1
00000704,0064,,        CLRWDT
00000705,26F0,,        CALL            Retardo_1s
00000706,0BD5,,        DECFSZ          R_ContSeg,F
00000707,2F04,,        GOTO            Retardo_wseg1
00000708,0008,,        RETURN
,,,
,,,        INCLUDE "D:\Electronica\RelojMA\Librerias\BUS_I2C.INC"
,,,;**************************** Librería "BUS_I2C.INC" ************************************
,,,;
,,,;       ===================================================================
,,,;         Del libro "MICROCONTROLADOR PIC16F84. DESARROLLO DE PROYECTOS"
,,,;         E. Palacios, F. Remiro y L. López.
,,,;         Editorial Ra-Ma.  www.ra-ma.es
,,,;       ===================================================================
,,,;
,,,; Estas subrutinas permiten realizar las tareas básicas de control del bus serie I2C,
,,,; por parte de un solo microcontrolador maestro.
,,,;
,,,; ZONA DE DATOS **********************************************************************
,,,;
,,,        CBLOCK
,,,        I2C_ContadorBits                ; Cuenta los bits a transmitir o a recibir.
,,,        I2C_Dato                        ; Dato a transmitir o recibido.
,,,        I2C_Flags                       ; Guarda la información del estado del bus I2C.
,,,        ENDC
,,,
,,,#DEFINE I2C_UltimoByteLeer      I2C_Flags,0
,,,;    -  (I2C_UltimoByteLeer)=0, NO es el último byte a leer por el maestro.
,,,;    -  (I2C_UltimoByteLeer)=1, SÍ es el último byte a leer por el maestro.
,,,
,,,; La definición de las líneas SCL y SDA del bus I2C se puede cambiar según las
,,,; necesidades del hardware.
,,,
,,,#DEFINE SCL     PORTA,3                 ; Línea SCL del bus I2C.
,,,#DEFINE SDA     PORTA,4                 ; Línea SDA del bus I2C.
,,,;
,,,; Subrutina "SDA_Bajo" -------------------------------------------------------------------------------
,,,;
00000709,,SDA_Bajo,SDA_Bajo
00000709,1683,,        bsf     STATUS,RP0              ; Configura la línea SDA como salida.
0000070A,1205,,        bcf     SDA
0000070B,1283,,        bcf     STATUS,RP0
0000070C,1205,,        bcf     SDA                     ; SDA en bajo.
0000070D,0008,,        return
,,,;
,,,; Subrutina "SDA_AltaImpedancia" --------------------------------------------------------
,,,;
0000070E,,SDA_AltaImpedancia,SDA_AltaImpedancia
0000070E,1683,,        bsf     STATUS,RP0              ; Configura la línea SDA entrada.
0000070F,1605,,        bsf     SDA                     ; Lo pone en alta impedancia y, gracias a la
00000710,1283,,        bcf     STATUS,RP0              ; Rp de esta línea, se mantiene a nivel alto.
00000711,0008,,        return
,,,;
,,,; Subrutina "SCL_Bajo" ------------------------------------------------------------------
,,,;
00000712,,SCL_Bajo,SCL_Bajo
00000712,1683,,        bsf     STATUS,RP0
00000713,1185,,        bcf     SCL                     ; Configura la línea SCL como salida.
00000714,1283,,        bcf     STATUS,RP0
00000715,1185,,        bcf     SCL                     ; La línea de reloj SCL en bajo.
00000716,0008,,        return
,,,;
,,,; Subrutina "SCL_AltaImpedancia" --------------------------------------------------------
,,,;
00000717,,SCL_AltaImpedancia,SCL_AltaImpedancia
00000717,1683,,        bsf     STATUS,RP0              ; Configura la línea SCL entrada.
00000718,1585,,        bsf     SCL                     ; Lo pone en alta impedancia y, gracias a la Rp
00000719,1283,,        bcf     STATUS,RP0              ; de esta línea, se mantiene a nivel alto.
0000071A,,SCL_EsperaNivelAlto,SCL_EsperaNivelAlto
0000071A,1D85,,        btfss   SCL                     ; Si algún esclavo mantiene esta línea en bajo
0000071B,2F1A,,        goto    SCL_EsperaNivelAlto     ; hay que esperar.
0000071C,0008,,        return
,,,;
,,,; Subrutina "I2C_EnviaStart" ------------------------------------------------------------
,,,;
,,,; Esta subrutina envía una condición de Start o inicio.
,,,;
0000071D,,I2C_EnviaStart,I2C_EnviaStart
0000071D,270E,,        call    SDA_AltaImpedancia      ; Línea SDA en alto.
0000071E,2717,,        call    SCL_AltaImpedancia      ; Línea SCL en alto.
0000071F,26BF,,        call    Retardo_4micros         ; Tiempo tBUF del protocolo.
00000720,2709,,        call    SDA_Bajo                ; Flanco de bajada de SDA mientras SCL está alto.
00000721,26BF,,        call    Retardo_4micros         ; Tiempo tHD;STA del protocolo.
00000722,2712,,        call    SCL_Bajo                ; Flanco de bajada del reloj SCL.
00000723,26BF,,        call    Retardo_4micros
00000724,0008,,        return
,,,;
,,,; Subrutina "I2C_EnviaStop" -------------------------------------------------------------
,,,;
,,,; Esta subrutina envía un condición de Stop o parada.
,,,;
00000725,,I2C_EnviaStop,I2C_EnviaStop
00000725,2709,,        call    SDA_Bajo
00000726,2717,,        call    SCL_AltaImpedancia      ; Flanco de subida de SCL.
00000727,26BF,,        call    Retardo_4micros         ; Tiempo tSU;STO del protocolo.
00000728,270E,,        call    SDA_AltaImpedancia      ; Flanco de subida de SDA.
00000729,26BF,,        call    Retardo_4micros         ; Tiempo tBUF del protocolo.
0000072A,0008,,        return
,,,;
,,,; Subrutina "I2C_EnviaByte" -------------------------------------------------------------
,,,;
,,,; El microcontrolador maestro transmite un byte por el bus I2C, comenzando por el bit
,,,; MSB. El byte a transmitir debe estar cargado previamente en el registro de trabajo W.
,,,; De la subrutina ejecutada anteriormente I2C_EnviaStart o esta misma I2C_EnviaByte,
,,,; la línea SCL se debe encontrar a nivel bajo al menos durante 5 µs.
,,,;
0000072B,,I2C_EnviaByte,I2C_EnviaByte
0000072B,00D7,,        movwf   I2C_Dato                        ; Almacena el byte a transmitir.
0000072C,3008,,        movlw   0x08                    ; A transmitir 8 bits.
0000072D,00D6,,        movwf   I2C_ContadorBits
0000072E,,I2C_EnviaBit,I2C_EnviaBit
0000072E,0DD7,,        rlf     I2C_Dato,F              ; Chequea el bit, llevándolo previamente al Carry.
0000072F,1803,,        btfsc   STATUS,C
00000730,2F33,,        goto    I2C_EnviaUno
00000731,,I2C_EnviaCero,I2C_EnviaCero
00000731,2709,,        call    SDA_Bajo                ; Si es "0" envía un nivel bajo.
00000732,2F34,,        goto    I2C_FlancoSCL
00000733,,I2C_EnviaUno,I2C_EnviaUno
00000733,270E,,        call    SDA_AltaImpedancia      ; Si es "1" lo activará a alto.
00000734,,I2C_FlancoSCL,I2C_FlancoSCL
00000734,2717,,        call    SCL_AltaImpedancia      ; Flanco de subida del SCL.
00000735,26BF,,        call    Retardo_4micros         ; Tiempo tHIGH del protocolo.
00000736,2712,,        call    SCL_Bajo                ; Termina el semiperiodo positivo del reloj.
00000737,26BF,,        call    Retardo_4micros         ; Tiempo tHD;DAT del protocolo.
00000738,0BD6,,        decfsz  I2C_ContadorBits,F              ; Lazo para los ocho bits.
00000739,2F2E,,        goto    I2C_EnviaBit
,,,;
0000073A,270E,,        call    SDA_AltaImpedancia      ; Libera la línea de datos.
0000073B,2717,,        call    SCL_AltaImpedancia      ; Pulso en alto de reloj para que el esclavo
0000073C,26BF,,        call    Retardo_4micros         ; pueda enviar el bit ACK.
0000073D,2712,,        call    SCL_Bajo
0000073E,26BF,,        call    Retardo_4micros
0000073F,0008,,        return
,,,;
,,,; Subrutina "I2C_LeeByte" ---------------------------------------------------------------
,,,;
,,,; El microcontrolador maestro lee un byte desde el esclavo conectado al bus I2C. El dato
,,,; recibido se carga en el registro I2C_Dato y lo envía a la subrutina superior a través
,,,; del registro W. Se empieza a leer por el bit de mayor peso MSB.
,,,; De alguna de las subrutinas ejecutadas anteriormente I2C_EnviaStart, I2C_EnviaByte
,,,; o esta misma I2C_LeeByte, la línea SCL lleva en bajo al menos 5 µs.
,,,
00000740,,I2C_LeeByte,I2C_LeeByte
00000740,3008,,        movlw   0x08                    ; A recibir 8 bits.
00000741,00D6,,        movwf   I2C_ContadorBits
00000742,270E,,        call    SDA_AltaImpedancia      ; Deja libre la línea de datos.
00000743,,I2C_LeeBit,I2C_LeeBit
00000743,2717,,        call    SCL_AltaImpedancia      ; Flanco de subida del reloj.
00000744,1003,,        bcf     STATUS,C                ; En principio supone que es "0".
00000745,1A05,,        btfsc   SDA                     ; Lee el bit
00000746,1403,,        bsf     STATUS,C                ; Si es "1" carga 1 en el Carry.
00000747,0DD7,,        rlf     I2C_Dato,F              ; Lo introduce en el registro.
00000748,2712,,        call    SCL_Bajo                ; Termina el semiperiodo positivo del reloj.
00000749,26BF,,        call    Retardo_4micros         ; Tiempo tHD;DAT del protocolo.
0000074A,0BD6,,        decfsz  I2C_ContadorBits,F              ; Lazo para los 8 bits.
0000074B,2F43,,        goto    I2C_LeeBit
,,,;
,,,; Chequea si este es el último byte a leer para enviar o no el bit de reconocimiento
,,,; ACK en consecuencia.
,,,;
0000074C,1C58,,        btfss   I2C_UltimoByteLeer      ; Si es el último, no debe enviar
,,,                                        ; el bit de reconocimiento ACK.
0000074D,2709,,        call    SDA_Bajo                ; Envía el bit de reconocimiento ACK
,,,                                        ; porque todavía no es el último byte a leer.
0000074E,2717,,        call    SCL_AltaImpedancia      ; Pulso en alto del SCL para transmitir el
0000074F,26BF,,        call    Retardo_4micros         ; bit ACK de reconocimiento. Este es tHIGH.
00000750,2712,,        call    SCL_Bajo                ; Pulso de bajada del SCL.
00000751,26BF,,        call    Retardo_4micros
00000752,0857,,        movf    I2C_Dato,W              ; El resultado se manda en el registro de
00000753,0008,,        return                          ; de trabajo W.
,,,
,,,;       ===================================================================
,,,;         Del libro "MICROCONTROLADOR PIC16F84. DESARROLLO DE PROYECTOS"
,,,;         E. Palacios, F. Remiro y L. López.
,,,;         Editorial Ra-Ma.  www.ra-ma.es
,,,;       ===================================================================
,,,        INCLUDE "D:\Electronica\RelojMA\Librerias\DS1307.INC"
,,,;******************************** Librería DS1307.INC ***********************************
,,,;
,,,;       ===================================================================
,,,;         Del libro "MICROCONTROLADOR PIC16F84. DESARROLLO DE PROYECTOS"
,,,;         E. Palacios, F. Remiro y L. López.
,,,;         Editorial Ra-Ma.  www.ra-ma.es
,,,;       ===================================================================
,,,;
,,,; Estas subrutinas permiten realizar las tareas de manejo del reloj-calendario DS1307
,,,; Este dispositivo transmite la información vía serie a través de un bus I2C.
,,,;
,,,; ZONA DE DATOS **********************************************************************
,,,
,,,        CBLOCK
,,,        Anho                            ; Guarda el año.
,,,        Mes                             ; Guarda el mes.
,,,        Dia                             ; Guarda el día.
,,,        DiaSemana                       ; Guarda el día de la semana: lunes, etc.
,,,        Hora                            ; Guarda las horas.
,,,        Minuto                          ; Guarda los minutos.
,,,        Segundo                         ; Guarda los segundos.
,,,        ENDC
,,,
,,,DS1307_DireccionEscritura       EQU     0xD0    ; Dirección del DS1307.
,,,DS1307_DireccionLectura EQU     0xD1
,,,
,,,; Subrutina "DS1307_Inicializa" ---------------------------------------------------------
,,,;
,,,; Configura la señal cuadrada que genera el DS1307 en su pin SQW/OUT a 1 Hz.
,,,
00000754,,DS1307_Inicializa,DS1307_Inicializa
00000754,271D,,        call    I2C_EnviaStart          ; Envía condición de Start.
00000755,30D0,,        movlw   DS1307_DireccionEscritura       ; Indica al DS1307 que el byte a escribir,
00000756,272B,,        call    I2C_EnviaByte           ; está en la posición 07h, que corresponde
00000757,3007,,        movlw   0x07                    ; al control de la señal cuadrada.
00000758,272B,,        call    I2C_EnviaByte
00000759,3010,,        movlw   b'00010000'             ; Escribe en el registro de control para
0000075A,272B,,        call    I2C_EnviaByte           ; configurar onda cuadrada del DS1307 a 1 Hz.
0000075B,2725,,        call    I2C_EnviaStop           ; Termina de enviar datos.
0000075C,0008,,        return
,,,
,,,; Subrutina "DS1307_Lee" ----------------------------------------------------------------
,,,;
,,,; Se leen las variables de tiempo del DS1307 y se guardan en los registros correspondientes.
,,,;
0000075D,,DS1307_Lee,DS1307_Lee
0000075D,1058,,        bcf     I2C_UltimoByteLeer
0000075E,271D,,        call    I2C_EnviaStart          ; Envía condición de Start.
0000075F,30D0,,        movlw   DS1307_DireccionEscritura       ; Indica al DS1307 que el primer byte
00000760,272B,,        call    I2C_EnviaByte           ; a leer está en la posición 00H, que corresponde
00000761,3000,,        movlw   0x00                    ; a los segundos.
00000762,272B,,        call    I2C_EnviaByte
00000763,2725,,        call    I2C_EnviaStop           ; Envía condición de Stop.
,,,                                        ; Ahora va a leer el DS1307.
00000764,271D,,        call    I2C_EnviaStart          ; Envía condición de Start.
00000765,30D1,,        movlw   DS1307_DireccionLectura
00000766,272B,,        call    I2C_EnviaByte
00000767,2740,,        call    I2C_LeeByte             ; Lee los segundos.
00000768,00DF,,        movwf   Segundo                 ; Lo carga en el registro correspondiente.
00000769,2740,,        call    I2C_LeeByte             ; Lee el resto de los registros utilizando
0000076A,397F,,        andlw   b'01111111'
0000076B,00DE,,        movwf   Minuto                  ; el mismo procedimiento.
0000076C,2740,,        call    I2C_LeeByte
0000076D,393F,,        andlw   b'00111111'
0000076E,00DD,,        movwf   Hora
0000076F,2740,,        call    I2C_LeeByte
00000770,00DC,,        movwf   DiaSemana
00000771,2740,,        call    I2C_LeeByte
00000772,00DB,,        movwf   Dia
00000773,2740,,        call    I2C_LeeByte
00000774,00DA,,        movwf   Mes
00000775,1458,,        bsf     I2C_UltimoByteLeer      ; Para terminar.
00000776,2740,,        call    I2C_LeeByte
00000777,00D9,,        movwf   Anho
00000778,2725,,        call    I2C_EnviaStop           ; Acaba de leer.
00000779,0008,,        return
,,,
,,,; Subrutina "DS1307_CargaInicial" -------------------------------------------------------
,,,;
,,,; Realiza una carga inicial en los registros internos del reloj-calendario DS1307 a fecha
,,,; Lunes, 1 de Enero de 2004 a las 0:00:00.
,,,;
0000077A,,DS1307_CargaInicial,DS1307_CargaInicial
0000077A,3001,,        movlw   .1                      ; Inicializa todos los datos del reloj: Año, mes,
0000077B,00DB,,        movwf   Dia                     ; día, día de la semana, hora, minuto y segundo.
0000077C,3001,,        movlw   .1
0000077D,00DA,,        movwf   Mes
0000077E,00DC,,        movwf   DiaSemana
0000077F,3012,,        movlw   0x12
00000780,00D9,,        movwf   Anho                    ; Inicializa en el año 2011.
00000781,01DD,,        clrf    Hora
00000782,01DE,,        clrf    Minuto
00000783,01DF,,        clrf    Segundo                 ; Después lo graba en el DS1307 para
,,,;       call    DS1307_Escribe          ; ponerlo en marcha.
,,,;       return
,,,;
,,,; Subrutina "DS1307_Escribe" ----------------------------------------------------------------
,,,;
,,,; Carga los datos de los registros Anho, Mes, etc., dentro del DS1307.
,,,
00000784,,DS1307_Escribe,DS1307_Escribe
00000784,271D,,        call    I2C_EnviaStart          ; Envía condición de Start.
00000785,30D0,,        movlw   DS1307_DireccionEscritura       ; Indica al DS1307 que el primer byte a escribir
00000786,272B,,        call    I2C_EnviaByte           ; está en la posición 00h que corresponde
00000787,3000,,        movlw   0x00                    ; a los segundos.
00000788,272B,,        call    I2C_EnviaByte
00000789,085F,,        movf    Segundo,W               ; Pasa los segundos de la memoria del PIC16F84A al
0000078A,272B,,        call    I2C_EnviaByte           ; DS1307.
0000078B,085E,,        movf    Minuto,W                ; Y se repite el proceso para el resto.
0000078C,272B,,        call    I2C_EnviaByte
0000078D,085D,,        movf    Hora,W
0000078E,272B,,        call    I2C_EnviaByte
0000078F,085C,,        movf    DiaSemana,W
00000790,272B,,        call    I2C_EnviaByte
00000791,085B,,        movf    Dia,W
00000792,272B,,        call    I2C_EnviaByte
00000793,085A,,        movf    Mes,W
00000794,272B,,        call    I2C_EnviaByte
00000795,0859,,        movf    Anho,W
00000796,272B,,        call    I2C_EnviaByte
00000797,2725,,        call    I2C_EnviaStop           ; Termina de enviar datos.
00000798,0008,,        return
,,,
,,,;       ===================================================================
,,,;         Del libro "MICROCONTROLADOR PIC16F84. DESARROLLO DE PROYECTOS"
,,,;         E. Palacios, F. Remiro y L. López.
,,,;         Editorial Ra-Ma.  www.ra-ma.es
,,,;       ===================================================================
,,,
,,,        INCLUDE "D:\Electronica\RelojMA\Librerias\EEPROM.INC"
,,,        CBLOCK
,,,        EETEMPINTCON
,,,        ENDC
,,,
,,,; EEDIR *******************************************************************************************
,,,; Coloca el dato que esta en W en la dirección de la EEPROM
,,,
00000799,,EEDIR,EEDIR
00000799,1283,,        BCF     STATUS,RP0              ; Acceso al banco 2
0000079A,1703,,        BSF     STATUS,RP1
0000079B,008D,,        MOVWF   EEADR
0000079C,1283,,        BCF     STATUS,RP0              ; Acceso al banco 0
0000079D,1303,,        BCF     STATUS,RP1
0000079E,0008,,        RETURN
,,,
0000079F,,EELEER,EELEER
0000079F,1683,,        BSF     STATUS,RP0              ; Acceso al banco 3
000007A0,1703,,        BSF     STATUS,RP1
000007A1,138C,,        BCF     EECON1,EEPGD            ; Apuntar a la memoria de datos
000007A2,140C,,        BSF     EECON1,RD               ; Orden para empezar lectura
000007A3,,EELEER1,EELEER1
000007A3,180C,,        BTFSC   EECON1,RD
000007A4,2FA3,,        GOTO    EELEER1
000007A5,1283,,        BCF     STATUS,RP0              ; Acceso al banco 2
000007A6,1703,,        BSF     STATUS,RP1
000007A7,080C,,        MOVF    EEDATA,W
000007A8,1303,,        BCF     STATUS,RP1              ; Acceso al banco0
000007A9,0008,,        RETURN
,,,
000007AA,,EEESCRIBIR,EEESCRIBIR
000007AA,1283,,        BCF     STATUS,RP0              ; Acceso al banco 2
000007AB,1703,,        BSF     STATUS,RP1
000007AC,008C,,        MOVWF   EEDATA
000007AD,1283,,        BCF     STATUS,RP0              ; Acceso al banco 0
000007AE,1303,,        BCF     STATUS,RP1
000007AF,080B,,        MOVF    INTCON,W
000007B0,00E0,,        MOVWF   EETEMPINTCON
000007B1,1683,,        BSF     STATUS,RP0              ; Acceso al banco 3
000007B2,1703,,        BSF     STATUS,RP1
000007B3,138B,,        BCF     INTCON,GIE              ; Deshabilita las interrupciones
000007B4,138C,,        BCF     EECON1,EEPGD            ; Apuntar a la memoria de datos
000007B5,150C,,        BSF     EECON1,WREN             ; Habilita la escritura
,,,
000007B6,3055,,        MOVLW   0x55
000007B7,008D,,        MOVWF   EECON2
000007B8,30AA,,        MOVLW   0xAA
000007B9,008D,,        MOVWF   EECON2
000007BA,148C,,        BSF     EECON1,WR               ; Inicia la escritura
,,,
000007BB,,EEESCRIBIR2,EEESCRIBIR2
000007BB,188C,,        BTFSC   EECON1,WR
000007BC,2FBB,,        GOTO    EEESCRIBIR2
000007BD,110C,,        BCF     EECON1,WREN
000007BE,120C,,        BCF     EECON1,EEIF
000007BF,1283,,        BCF     STATUS,RP0              ; Acceso al banco 0
000007C0,1303,,        BCF     STATUS,RP1
000007C1,0860,,        MOVF    EETEMPINTCON,W
000007C2,008B,,        MOVWF   INTCON
000007C3,0008,,        RETURN
,,,
,,,
,,,
,,,
,,,
,,,
,,,
000007C4,,FINPAGINA0,FINPAGINA0
,,,        IF (FINPAGINA0 > 0x800)
,,,                ERROR   "Atención: La pagina 0 ha sobrepasado su rango"
,,,                MESSG   "de los primeros 7000"
,,,        ENDIF
,,,; PAGINA 1 *********************************************************************************************
,,,; PAGINA 1 *********************************************************************************************
,,,; PAGINA 1 *********************************************************************************************
,,,; PAGINA 1 *********************************************************************************************
,,,; PAGINA 1 *********************************************************************************************
,,,
00000900,,,        ORG     0x900
,,,
,,,        INCLUDE "D:\Electronica\RelojMA\Librerias\BINAD99.INC"
,,,;************************************** Librería "BINAD99.INC" **************************************
,,,;
,,,;
,,,;
,,,;
,,,;     ====================================================================================
,,,;     ||                               PROYECTO DE GRADO                                ||
,,,;     ||                                                                                ||
,,,;     ||     ESTUDIO Y DISEÑO DE ALGORITMOS E INTERFAZ ELECTRÓNICA DE COMUNICACIÓN      ||
,,,;     ||    ENTRE MICROCONTROLADORES SERIE PIC Y DISPOSITIVOS DE ALMACENAMIENTO USB     ||
,,,;     ||                                                                                ||
,,,;     ||                           Juan Pablo Ruiz Rosero                               ||
,,,;     ||                           Ingeniería Electrónica                               ||
,,,;     ||                            Universidad de Nariño                               ||
,,,;     ||                                Octubre 2008                                    ||
,,,;     ====================================================================================
,,,;
,,,;
,,,;****************************************************************************************************
,,,
,,,
,,,; ZONA DE DATOS *************************************************************************************
,,,;****************************************************************************************************
,,,;****************************************************************************************************
,,,
,,,        CBLOCK
,,,        D99UNI          ; Unidades
,,,        D99DEC          ; Decenas
,,,        ENDC
,,,
,,,
,,,; ZONA DE FUNCIONES *********************************************************************************
,,,;****************************************************************************************************
,,,;****************************************************************************************************
,,,
,,,
,,,;FUNCION DE BINARIO A DECIMAL 99 *******************************************************************
,,,; Esta función convierte un valor de binario a decimal igual o menor a 99. El dato de entrada se
,,,; lo coloca en W y la función devuelve su respuesta en W donde el nibble mayor representa las
,,,; centenas y el nibble menor las unidades. Si el dato de entrada es mayor a 99 devuelve el Carry
,,,; en 1 y si el dato es menor o igual a 99 devuelve el Carry 0.
00000900,,BINAD99,BINAD99
00000900,00E1,,        MOVWF   D99UNI                  ; Coloca el dato de entrada en D99UNI
00000901,01E2,,        CLRF    D99DEC                  ; Coloca en cero a D99DEC
00000902,,BINAD991,BINAD991
00000902,300A,,        MOVLW   d'10'                   ; Resta 10 a D99UNI y lo almacena en W
00000903,0261,,        SUBWF   D99UNI,W
00000904,1C03,,        BTFSS   STATUS,C
00000905,290F,,        GOTO    BINAD99F                ; Si el resultado es negativo, D99UNI<10 termina
00000906,,BINAD992,BINAD992                                ; Si el resultado es cero o positivo, D99UNI>=10
00000906,00E1,,        MOVWF   D99UNI                  ; Aplica el resultado de la resta sobre D99UNI
00000907,0AE2,,        INCF    D99DEC,F                ; Incrementa en uno las decenas
00000908,300A,,        MOVLW   d'10'                   ; Resta 10 a D99UNI para saber si las decenas
00000909,0262,,        SUBWF   D99DEC,W                ; son mayores que 10
0000090A,1C03,,        BTFSS   STATUS,C
0000090B,2902,,        GOTO    BINAD991                ; Si el resultado es negativo, D99DEC<10 continua
0000090C,,BINAD99E,BINAD99E                                ; si es positivo, D99DEC>10 va a error
0000090C,00E2,,        MOVWF   D99DEC
0000090D,1403,,        BSF     STATUS,C                ; Coloca el Carry en 1 para avizar que hay un error
0000090E,0008,,        RETURN                          ; Finaliza
0000090F,,BINAD99F,BINAD99F
0000090F,0EE2,,        SWAPF   D99DEC,F                ; Rota los nibbles de D99DEC
00000910,0862,,        MOVF    D99DEC,W
