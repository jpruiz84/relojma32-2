00000E07,341C,,        RETLW   b'00011100'
00000E08,341C,,        RETLW   b'00011100'
00000E09,340F,,        RETLW   b'00001111'
,,,
00000E0A,3400,,        RETLW   b'00000000'
00000E0B,3403,,        RETLW   b'00000011'
00000E0C,340E,,        RETLW   b'00001110'
00000E0D,3418,,        RETLW   b'00011000'
00000E0E,3403,,        RETLW   b'00000011'
00000E0F,3403,,        RETLW   b'00000011'
00000E10,3400,,        RETLW   b'00000000'
00000E11,341F,,        RETLW   b'00011111'
,,,
00000E12,341E,,        RETLW   b'00011110'
00000E13,341E,,        RETLW   b'00011110'
00000E14,3406,,        RETLW   b'00000110'
00000E15,3400,,        RETLW   b'00000000'
00000E16,341E,,        RETLW   b'00011110'
00000E17,341E,,        RETLW   b'00011110'
00000E18,3406,,        RETLW   b'00000110'
00000E19,341E,,        RETLW   b'00011110'
,,,
00000E1A,340F,,        RETLW   b'00001111'
00000E1B,340F,,        RETLW   b'00001111'
00000E1C,340C,,        RETLW   b'00001100'
00000E1D,340C,,        RETLW   b'00001100'
00000E1E,340C,,        RETLW   b'00001100'
00000E1F,340C,,        RETLW   b'00001100'
00000E20,340C,,        RETLW   b'00001100'
00000E21,340F,,        RETLW   b'00001111'
,,,
00000E22,3400,,        RETLW   b'00000000'
00000E23,3418,,        RETLW   b'00011000'
00000E24,340E,,        RETLW   b'00001110'
00000E25,3403,,        RETLW   b'00000011'
00000E26,3400,,        RETLW   b'00000000'
00000E27,3400,,        RETLW   b'00000000'
00000E28,3400,,        RETLW   b'00000000'
00000E29,341F,,        RETLW   b'00011111'
,,,
00000E2A,3400,,        RETLW   b'00000000'
00000E2B,3400,,        RETLW   b'00000000'
00000E2C,3400,,        RETLW   b'00000000'
00000E2D,3410,,        RETLW   b'00010000'
00000E2E,341C,,        RETLW   b'00011100'
00000E2F,3407,,        RETLW   b'00000111'
00000E30,3407,,        RETLW   b'00000111'
00000E31,341E,,        RETLW   b'00011110'
,,,
