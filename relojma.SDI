00000532,1D03,,        BTFSS   STATUS,Z
00000533,0008,,        RETURN
,,,
,,,        ; El timbre sonara
00000534,0AC2,,        INCF    SONADAALARMAMF,F        ; Setea la bandera de alarma sonada
,,,                                        ; El timbre va a sonar, lee las duraciones
00000535,30FB,,        MOVLW   EEDDTIMBREC             ; Posición en EEPROM de timbre corto
00000536,2799,,        CALL    EEDIR
00000537,279F,,        CALL    EELEER
00000538,00C0,,        MOVWF   DTIMBREC
00000539,30FC,,        MOVLW   EEDDTIMBREL             ; Posición en EEPROM de timbre largo
0000053A,2799,,        CALL    EEDIR
0000053B,279F,,        CALL    EELEER
0000053C,00C1,,        MOVWF   DTIMBREL
,,,
,,,        ; Lee el timpo de timbrado
0000053D,082B,,        MOVF    VTIPOHORARIO,W          ; Mueve Vtipodehorario a contador
0000053E,00A7,,        MOVWF   CONTADOR
0000053F,0825,,        MOVF    NALARMA,W               ; Guarda NALARMA en NALARMAP
00000540,00A6,,        MOVWF   NALARMAP
,,,
00000541,,TESTEARALARMA1B,TESTEARALARMA1B
00000541,0BA7,,        DECFSZ  CONTADOR,F              ; Si VTIPODEHORARIO es 1 NALARMAP=NARALMA
00000542,2D44,,        GOTO    TESTEARALARMA1BB
00000543,2D47,,        GOTO    TESTEARALARMA1C         ; Si no es uno NALARMAP=NALARMA+VTIPODEHORARIO*30
00000544,,TESTEARALARMA1BB,TESTEARALARMA1BB
00000544,301E,,        MOVLW   d'30'
00000545,07A6,,        ADDWF   NALARMAP,F
00000546,2D41,,        GOTO    TESTEARALARMA1B
,,,
00000547,,TESTEARALARMA1C,TESTEARALARMA1C
00000547,0826,,        MOVF    NALARMAP,W
00000548,1003,,        BCF     STATUS,C
00000549,0D26,,        RLF     NALARMAP,W
0000054A,2799,,        CALL    EEDIR
0000054B,279F,,        CALL    EELEER
0000054C,2513,,        CALL    ROTAR6D
0000054D,3903,,        ANDLW   b'00000011'
0000054E,00AE,,        MOVWF   TIPOTIMBRE
,,,
,,,
0000054F,1487,,        BSF     PINLEDLCD               ; Enciende la luz del LCD
00000550,082E,,        MOVF    TIPOTIMBRE,W
00000551,1903,,        BTFSC   STATUS,Z
00000552,2D6B,,        GOTO    TIMBRAR1TC
00000553,082E,,        MOVF    TIPOTIMBRE,W
00000554,3C01,,        SUBLW   0x01
00000555,1903,,        BTFSC   STATUS,Z
00000556,2D72,,        GOTO    TIMBRAR1TL
00000557,082E,,        MOVF    TIPOTIMBRE,W
00000558,3C02,,        SUBLW   0x02
00000559,1903,,        BTFSC   STATUS,Z
0000055A,2D79,,        GOTO    TIMBRAR2TC
0000055B,082E,,        MOVF    TIPOTIMBRE,W
0000055C,3C03,,        SUBLW   0x03
0000055D,1903,,        BTFSC   STATUS,Z
0000055E,2D87,,        GOTO    TIMBRAR3TC
,,,
